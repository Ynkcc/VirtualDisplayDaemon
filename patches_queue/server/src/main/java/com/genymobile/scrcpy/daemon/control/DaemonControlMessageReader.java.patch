+package com.genymobile.scrcpy.daemon.control;
+
+import com.genymobile.scrcpy.control.ControlMessage;
+import com.genymobile.scrcpy.daemon.net.DaemonWire;
+import com.genymobile.scrcpy.daemon.net.TcpDesktopConnection;
+
+import java.io.DataInputStream;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+
+public final class DaemonControlMessageReader {
+
+    private static final int MAX_ROLE_ENTRIES = 64;
+
+    private DaemonControlMessageReader() {
+    }
+
+    public static ControlMessage read(int type, DataInputStream dis) throws IOException {
+        switch (type) {
+            case DaemonMessages.TYPE_CREATE_VIRTUAL_DISPLAY:
+                return parseCreateVirtualDisplay(dis);
+            case DaemonMessages.TYPE_RELEASE_VIRTUAL_DISPLAY:
+                return parseReleaseVirtualDisplay(dis);
+            case DaemonMessages.TYPE_RESIZE_VIRTUAL_DISPLAY:
+                return parseResizeVirtualDisplay(dis);
+            case DaemonMessages.TYPE_START_ACTIVITY:
+                return parseStartActivityWithDisplay(dis);
+            case DaemonMessages.TYPE_GET_ACTIVE_DISPLAY_IDS:
+                return DaemonMessages.createGetActiveDisplayIds(dis.readLong());
+            case DaemonMessages.TYPE_EXIT_DAEMON:
+                return DaemonMessages.createExitDaemon(dis.readLong());
+            case DaemonMessages.TYPE_GET_ROTATION:
+                return DaemonMessages.createGetRotation(dis.readLong(), dis.readInt());
+            case DaemonMessages.TYPE_FREEZE_ROTATION:
+                return DaemonMessages.createFreezeRotation(dis.readLong(), dis.readInt(), dis.readInt());
+            case DaemonMessages.TYPE_THAW_ROTATION:
+                return DaemonMessages.createThawRotation(dis.readLong(), dis.readInt());
+            case DaemonMessages.TYPE_IS_ROTATION_FROZEN:
+                return DaemonMessages.createIsRotationFrozen(dis.readLong(), dis.readInt());
+            case DaemonMessages.TYPE_GET_ACTIVE_DISPLAY_INFOS:
+                return DaemonMessages.createGetActiveDisplayInfos(dis.readLong());
+            case DaemonMessages.TYPE_CONFIGURE_SESSION:
+                return parseConfigureSession(dis);
+            case DaemonMessages.TYPE_LAUNCH_HOME:
+                return DaemonMessages.createLaunchHome(dis.readLong(), dis.readInt());
+            case DaemonMessages.TYPE_LIST_APPS:
+                return DaemonMessages.createListApps(dis.readLong());
+            case DaemonMessages.TYPE_PING:
+                return DaemonMessages.createPing(dis.readLong());
+            default:
+                return null;
+        }
+    }
+
+    private static ControlMessage parseCreateVirtualDisplay(DataInputStream dis) throws IOException {
+        long sequence = dis.readLong();
+        String name = DaemonWire.readString(dis);
+        int width = dis.readInt();
+        int height = dis.readInt();
+        int dpi = dis.readInt();
+        int flags = dis.readInt();
+        // 固定布局：客户端总是发送 displayId（默认 -1），不做 EOF 探测。
+        int displayId = dis.readInt();
+        return DaemonMessages.createCreateVirtualDisplay(sequence, name, width, height, dpi, flags, displayId);
+    }
+
+    private static ControlMessage parseReleaseVirtualDisplay(DataInputStream dis) throws IOException {
+        long sequence = dis.readLong();
+        int displayId = dis.readInt();
+        // 固定布局：客户端总是发送 1 字节 flag（0=不迁移，1=前台移回主屏）。
+        boolean moveTasksToDefaultDisplay = dis.readUnsignedByte() != 0;
+        return DaemonMessages.createReleaseVirtualDisplay(sequence, displayId, moveTasksToDefaultDisplay);
+    }
+
+    private static ControlMessage parseResizeVirtualDisplay(DataInputStream dis) throws IOException {
+        long sequence = dis.readLong();
+        int displayId = dis.readInt();
+        int width = dis.readInt();
+        int height = dis.readInt();
+        int dpi = dis.readInt();
+        return DaemonMessages.createResizeVirtualDisplay(sequence, displayId, width, height, dpi);
+    }
+
+    private static ControlMessage parseStartActivityWithDisplay(DataInputStream dis) throws IOException {
+        long sequence = dis.readLong();
+        String packageName = DaemonWire.readString(dis);
+        int displayId = dis.readInt();
+        return DaemonMessages.createStartActivity(sequence, packageName, displayId);
+    }
+
+    private static ControlMessage parseConfigureSession(DataInputStream dis) throws IOException {
+        long sequence = dis.readLong();
+        String optionsKv = DaemonWire.readString(dis);
+        int rolesMask = dis.readInt();
+        // 固定布局：int32 entriesCount，随后 entriesCount × (uint8 role, int32 displayId)。
+        // entriesCount=0 合法（仅 mask）。
+        int entriesCount = dis.readInt();
+        if (entriesCount < 0 || entriesCount > MAX_ROLE_ENTRIES) {
+            // 计数损坏时直接按协议错误失败，而非静默降级为 mask-only：否则客户端
+            // 已发的 entry 字节会滞留在流中，导致后续所有消息错位。
+            throw new IOException("CONFIGURE_SESSION invalid entriesCount=" + entriesCount);
+        }
+        if (entriesCount == 0) {
+            return DaemonMessages.createConfigureSession(sequence, optionsKv, rolesMask);
+        }
+        List<TcpDesktopConnection.RoleDisplayKey> entries = new ArrayList<>(entriesCount);
+        for (int i = 0; i < entriesCount; i++) {
+            int role = dis.readUnsignedByte();
+            int displayId = DaemonWire.readInt32(dis);
+            entries.add(new TcpDesktopConnection.RoleDisplayKey(role, displayId));
+        }
+        return DaemonMessages.createConfigureSession(sequence, optionsKv, rolesMask, entries);
+    }
+}
