+package com.genymobile.scrcpy.daemon.core;
+
+import com.genymobile.scrcpy.Options;
+import com.genymobile.scrcpy.control.ControlChannel;
+import com.genymobile.scrcpy.control.ControlMessage;
+import com.genymobile.scrcpy.control.ControlProtocolException;
+import com.genymobile.scrcpy.control.Controller;
+import com.genymobile.scrcpy.control.DeviceMessageSender;
+import com.genymobile.scrcpy.daemon.control.DaemonCommandHandler;
+import com.genymobile.scrcpy.daemon.display.DisplaySurfaceBroker;
+import com.genymobile.scrcpy.daemon.display.VirtualDisplayRegistry;
+import com.genymobile.scrcpy.daemon.display.VirtualDisplaySession;
+import com.genymobile.scrcpy.daemon.net.TcpDesktopConnection;
+import com.genymobile.scrcpy.daemon.video.FrameBroadcasterRegistry;
+import com.genymobile.scrcpy.device.Device;
+import com.genymobile.scrcpy.util.Ln;
+
+import java.io.FileDescriptor;
+import java.io.IOException;
+import java.net.Socket;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * 单个客户端的会话编排器，管理 per-session 的多显示器 role socket。
+ *
+ * <p><b>协议阶段</b>（服务端强制，无向后兼容）：
+ * <pre>
+ *   INIT       — ROLE_NEGOTIATION 刚打开；已分配 sessionId 并发送 device meta。
+ *                只接受 CONFIGURE_SESSION。
+ *   CONFIGURED — 客户端已发送 CONFIGURE_SESSION（optionsKv + rolesEntries 或
+ *                legacy rolesMask）。此时才接受声明过的 (role, displayId) 的
+ *                ROLE_VIDEO / ROLE_AUDIO / ROLE_CONTROL socket；同一 role 可为
+ *                不同显示器多次打开。CONFIGURE_SESSION 为一次性握手，重复发送被拒。
+ *   CLOSED     — 会话正在拆除；一切请求被拒。
+ * </pre>
+ */
+public final class ClientSession implements Runnable, SessionConfigurator {
+
+    private static final long STOP_JOIN_TIMEOUT_MS = 5000;
+    private static final long CONFIGURE_WAIT_TIMEOUT_MS = 2000;
+
+    private enum Phase {
+        INIT, CONFIGURED, CLOSED
+    }
+
+    private final int sessionId;
+    private final String tag;
+    private final TcpDesktopConnection connection;
+    private final Options options;
+    private final String[] baseArgs;
+    private final VirtualDisplayRegistry registry;
+    private final DisplaySurfaceBroker surfaceBroker;
+    private final DaemonExitCoordinator exitCoordinator;
+    private final DaemonServer server;
+    private final FrameBroadcasterRegistry broadcasterRegistry;
+
+    private volatile Options sessionOptions;
+    private volatile String[] sessionArgs;
+
+    /** 兼容用的 3-bit role 类型 mask。 */
+    private volatile int declaredRolesMask = 0;
+    /** CONFIGURE_SESSION 声明的精确 (role, displayId) 集合。 */
+    private volatile Set<TcpDesktopConnection.RoleDisplayKey> declaredRoleKeys = Collections.emptySet();
+
+    private volatile Phase phase = Phase.INIT;
+    private final CountDownLatch configuredLatch = new CountDownLatch(1);
+    private final AtomicBoolean exited = new AtomicBoolean(false);
+    // 独立的清理幂等守卫：shutdown() 先置 exited 再调 cleanup()，因此 cleanup() 不能
+    // 以 exited 的 false→true CAS 为门（该 CAS 必然失败，cleanup 永不执行）。
+    private final AtomicBoolean cleanedUp = new AtomicBoolean(false);
+
+    // 每个显示器一份视频控制器；多显示器即多实例。
+    private final Map<Integer, SessionVideoController> videoControllers = new ConcurrentHashMap<>();
+
+    private final Map<Integer, Controller> controllers = new ConcurrentHashMap<>();
+    private final Map<Integer, ControlLoopRunner> controlLoopRunners = new ConcurrentHashMap<>();
+
+    private volatile DaemonCommandHandler negotiationCommandHandler;
+
+    public ClientSession(Socket negotiationSocket, int sessionId, Options options, String[] baseArgs,
+                         VirtualDisplayRegistry registry, DisplaySurfaceBroker surfaceBroker,
+                         DaemonExitCoordinator exitCoordinator, DaemonServer server,
+                         FrameBroadcasterRegistry broadcasterRegistry) throws IOException {
+        this.sessionId = sessionId;
+        this.tag = DaemonLog.tag(sessionId);
+        this.connection = new TcpDesktopConnection(negotiationSocket, sessionId);
+        this.options = options;
+        this.baseArgs = baseArgs;
+        this.sessionOptions = options;
+        this.sessionArgs = baseArgs != null ? baseArgs.clone() : new String[0];
+        this.registry = registry;
+        this.surfaceBroker = surfaceBroker;
+        this.exitCoordinator = exitCoordinator;
+        this.server = server;
+        this.broadcasterRegistry = broadcasterRegistry;
+    }
+
+    @Override
+    public void run() {
+        Ln.i(tag + ": starting negotiation loop (phase=INIT)");
+        try {
+            connection.sendDeviceMeta(Device.getDeviceName());
+            Ln.i(tag + ": device meta sent via negotiation channel");
+        } catch (IOException e) {
+            // 设备名是握手的第一个字段：没发出去后续所有客户端读取都会错位，
+            // 继续协商只会让对端解析出垃圾数据。
+            Ln.e(tag + ": failed to send device meta, aborting session: " + e.getMessage(), e);
+            cleanup();
+            return;
+        }
+
+        DeviceMessageSender negotiationSender = null;
+        try {
+            negotiationSender = new DeviceMessageSender(connection.getNegotiationChannel());
+            negotiationSender.start();
+
+            negotiationCommandHandler = new DaemonCommandHandler(
+                    negotiationSender, registry, exitCoordinator, this, broadcasterRegistry, sessionId);
+
+            while (!exited.get() && !Thread.currentThread().isInterrupted()) {
+                ControlMessage msg;
+                try {
+                    msg = connection.getNegotiationChannel().recv();
+                } catch (ControlProtocolException e) {
+                    // 协议错误不是正常关闭：必须留痕，否则客户端发未知/错版本消息时
+                    // 服务端只表现为"连接没了"。
+                    Ln.e(tag + ": negotiation protocol error: " + e.getMessage(), e);
+                    break;
+                } catch (IOException e) {
+                    Ln.d(tag + ": negotiation socket closed or read error: " + e.getMessage());
+                    break;
+                }
+                if (msg == null) {
+                    // 读端返回 null 时无法继续协商，但不能静默结束会话。
+                    Ln.w(tag + ": negotiation reader returned no message, closing the session");
+                    break;
+                }
+                if (!negotiationCommandHandler.handle(msg)) {
+                    Ln.w(tag + ": unhandled message type in negotiation: " + msg.getType());
+                }
+            }
+        } catch (Throwable t) {
+            if (!exited.get()) {
+                Ln.e(tag + ": error in negotiation loop", t);
+            }
+        } finally {
+            if (negotiationSender != null) {
+                negotiationSender.stop();
+                try {
+                    negotiationSender.join();
+                } catch (InterruptedException ignored) {
+                    Thread.currentThread().interrupt();
+                }
+            }
+            if (negotiationCommandHandler != null) {
+                negotiationCommandHandler.close();
+            }
+            cleanup();
+            Ln.i(tag + ": closed");
+            if (exitCoordinator.isExitRequested()) {
+                Ln.i(tag + ": Exit coordinator requested shutdown, exiting.");
+            }
+        }
+    }
+
+    // -----------------------------------------------------------------------
+    // SessionConfigurator
+    // -----------------------------------------------------------------------
+
+    @Override
+    public void configure(String optionsKv, int legacyRolesMask,
+                          List<TcpDesktopConnection.RoleDisplayKey> rolesEntries) {
+        if (exited.get() || phase == Phase.CLOSED) {
+            throw new RuntimeException("Session already exited");
+        }
+        // CONFIGURE_SESSION is a one-shot handshake. Re-applying it would silently swap the
+        // session options while already-bound controllers keep the previous ones, so a second
+        // message is rejected instead of being merged (see the phase contract above).
+        if (phase == Phase.CONFIGURED) {
+            throw new IllegalStateException("CONFIGURE_SESSION already applied for this session");
+        }
+        String[] merged = DaemonArgs.mergeOptions(baseArgs, optionsKv);
+        Options parsed = Options.parse(merged);
+
+        // 与"尚未启动任何视频"检查在同一临界区内原子地发布 session 选项：否则接受线程
+        // 可能在 isEmpty() 判定与赋值之间创建视频控制器，使其拿到过期选项。onVideoSocket
+        // 的创建路径也持有同一把 videoControllers 监视器。
+        synchronized (videoControllers) {
+            if (!videoControllers.isEmpty()) {
+                throw new RuntimeException("Cannot configure session after video streams started");
+            }
+            this.sessionArgs = merged;
+            this.sessionOptions = parsed;
+        }
+        this.declaredRolesMask = legacyRolesMask;
+
+        if (rolesEntries != null && !rolesEntries.isEmpty()) {
+            Set<TcpDesktopConnection.RoleDisplayKey> keys = ConcurrentHashMap.newKeySet();
+            keys.addAll(rolesEntries);
+            this.declaredRoleKeys = Collections.unmodifiableSet(keys);
+            // 重建一个汇总 role 类型的 legacy mask，仅用于日志。
+            int combinedMask = 0;
+            for (TcpDesktopConnection.RoleDisplayKey k : keys) {
+                combinedMask |= (1 << k.role);
+            }
+            if (legacyRolesMask == 0) {
+                this.declaredRolesMask = combinedMask;
+            }
+        } else {
+            this.declaredRoleKeys = Collections.emptySet();
+        }
+
+        if (phase == Phase.INIT) {
+            phase = Phase.CONFIGURED;
+            configuredLatch.countDown();
+        }
+        Ln.i(tag + ": CONFIGURE_SESSION applied — phase=CONFIGURED"
+                + ", rolesMask=0b" + Integer.toBinaryString(this.declaredRolesMask)
+                + ", rolesEntries=" + this.declaredRoleKeys.size()
+                + ", " + Math.max(0, merged.length - 1) + " option keys");
+    }
+
+    // -----------------------------------------------------------------------
+    // Role socket 门禁 — 非 CONFIGURED 或未声明则拒绝。
+    // -----------------------------------------------------------------------
+
+    private boolean acceptRoleSocket(int role, int displayId) {
+        if (phase == Phase.INIT) {
+            try {
+                if (!configuredLatch.await(CONFIGURE_WAIT_TIMEOUT_MS, TimeUnit.MILLISECONDS)) {
+                    Ln.w(tag + ": timeout waiting for CONFIGURE_SESSION");
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            }
+        }
+        if (phase != Phase.CONFIGURED) {
+            Ln.w(tag + ": rejecting role socket — phase=" + phase
+                    + " (must complete CONFIGURE_SESSION first)");
+            return false;
+        }
+        Set<TcpDesktopConnection.RoleDisplayKey> keys = declaredRoleKeys;
+        if (!keys.isEmpty()) {
+            // 多显示器模式：要求精确 (role,displayId) 声明。
+            if (!keys.contains(new TcpDesktopConnection.RoleDisplayKey(role, displayId))) {
+                Ln.w(tag + ": rejecting role socket "
+                        + new TcpDesktopConnection.RoleDisplayKey(role, displayId)
+                        + " — not declared in CONFIGURE_SESSION rolesEntries");
+                return false;
+            }
+            return true;
+        }
+        // 回退：legacy 3-bit mask（0 = 允许任意已声明 role 类型）。
+        int bit = 1 << role;
+        if (declaredRolesMask != 0 && (declaredRolesMask & bit) == 0) {
+            Ln.w(tag + ": rejecting role socket bit 0b"
+                    + Integer.toBinaryString(bit) + " — not declared in CONFIGURE_SESSION (mask=0b"
+                    + Integer.toBinaryString(declaredRolesMask) + ")");
+            return false;
+        }
+        return true;
+    }
+
+    // -----------------------------------------------------------------------
+    // Role socket 绑定 — 按 displayId 区分。
+    // -----------------------------------------------------------------------
+
+    public void onControlSocket(int displayId, Socket socket) {
+        if (exited.get() || !acceptRoleSocket(TcpDesktopConnection.ROLE_CONTROL, displayId)) {
+            TcpDesktopConnection.closeQuietly(socket);
+            return;
+        }
+        try {
+            // 确认：服务端回写 displayId，使客户端能确认路由。
+            TcpDesktopConnection.writeDisplayId(socket, displayId);
+
+            ControlChannel ch = connection.bindControlSocket(displayId, socket);
+            Ln.i(tag + ": control socket bound for displayId=" + displayId
+                    + ", launching scrcpy controller");
+
+            Controller stale = controllers.remove(displayId);
+            if (stale != null) {
+                stale.stop();
+                ControlLoopRunner staleRunner = controlLoopRunners.remove(displayId);
+                if (staleRunner != null) {
+                    // 带超时 join 作为安全网：若某个陈旧 controller 的 recv() 阻塞在无法
+                    // 关闭的 socket 上，无限 join 会永久占住本 role 线程。
+                    joinControlLoop(staleRunner, 3000, "stale, displayId=" + displayId);
+                }
+            }
+
+            int mirrorId = -1;
+            VirtualDisplaySession vdSession = registry.getSession(displayId);
+            if (vdSession != null) {
+                mirrorId = vdSession.getMirrorDisplayId();
+            }
+            Controller controller = new Controller(ch, null, sessionOptions, displayId, mirrorId);
+
+            // 职责去重：控制通道上的 daemon 命令一律吞掉并告警，命令只走协商通道。
+            controller.setControlMessageExtension(msg -> {
+                Ln.w(tag + ": daemon command type " + msg.getType()
+                        + " rejected on control channel (displayId=" + displayId
+                        + ") — send it on the negotiation channel instead");
+                return true;
+            });
+
+            controllers.put(displayId, controller);
+            // 迟到绑定：若共享 encoder/broadcaster 在控制 socket 之前创建（video-first），
+            // 当时的 ScreenCapture 监听器是空代理，现在把本 controller 接上。
+            broadcasterRegistry.attachListener(displayId, controller);
+
+            SessionVideoController vc = videoControllers.get(displayId);
+            if (vc != null) {
+                vc.setController(controller);
+            }
+
+            ControlLoopRunner runner = new ControlLoopRunner(sessionId);
+            controlLoopRunners.put(displayId, runner);
+            final Controller finalCtrl = controller;
+            final Socket ctrlSocket = socket;
+            runner.start(controller, fatalError -> {
+                Ln.i(tag + ": scrcpy controller terminated for displayId="
+                        + displayId + ", fatal=" + fatalError);
+                finalCtrl.stop();
+                // 关闭控制 socket，使客户端看到断连，而不是继续把触摸事件写进死循环。
+                TcpDesktopConnection.closeQuietly(ctrlSocket);
+            });
+        } catch (Throwable t) {
+            Ln.e(tag + ": failed to initialize scrcpy controller displayId=" + displayId, t);
+            TcpDesktopConnection.closeQuietly(socket);
+        }
+    }
+
+    public void onVideoSocket(int displayId, Socket socket) {
+        if (exited.get() || !acceptRoleSocket(TcpDesktopConnection.ROLE_VIDEO, displayId)) {
+            TcpDesktopConnection.closeQuietly(socket);
+            return;
+        }
+        SessionVideoController vc;
+        synchronized (videoControllers) {
+            vc = videoControllers.get(displayId);
+            if (vc == null) {
+                vc = new SessionVideoController(
+                        sessionId, displayId, new TcpVideoBindingAdapter(connection, displayId),
+                        sessionOptions, sessionArgs, broadcasterRegistry, registry, exited::get);
+                videoControllers.put(displayId, vc);
+                // 若该显示器的 controller 已存在，立即接线。
+                Controller ctrl = controllers.get(displayId);
+                if (ctrl != null) {
+                    vc.setController(ctrl);
+                }
+            }
+        }
+        try {
+            TcpDesktopConnection.writeDisplayId(socket, displayId);
+        } catch (IOException e) {
+            Ln.w(tag + ": failed to write displayId ack for video socket: " + e.getMessage());
+            TcpDesktopConnection.closeQuietly(socket);
+            return;
+        }
+        vc.bindVideoSocket(socket);
+    }
+
+    public void onAudioSocket(int displayId, Socket socket) {
+        if (exited.get() || !acceptRoleSocket(TcpDesktopConnection.ROLE_AUDIO, displayId)) {
+            TcpDesktopConnection.closeQuietly(socket);
+            return;
+        }
+        try {
+            TcpDesktopConnection.writeDisplayId(socket, displayId);
+            connection.bindAudioSocket(displayId, socket);
+        } catch (IOException e) {
+            Ln.e(tag + ": failed to bind audio socket displayId=" + displayId, e);
+            TcpDesktopConnection.closeQuietly(socket);
+        }
+    }
+
+    // 把 per-display FdChannel 适配为 SessionVideoController.TcpVideoBinding。
+    private static final class TcpVideoBindingAdapter implements SessionVideoController.TcpVideoBinding {
+        private final TcpDesktopConnection conn;
+        private final int displayId;
+
+        TcpVideoBindingAdapter(TcpDesktopConnection conn, int displayId) {
+            this.conn = conn;
+            this.displayId = displayId;
+        }
+
+        @Override
+        public FileDescriptor getVideoFd() {
+            return conn.getVideoFd(displayId);
+        }
+
+        @Override
+        public boolean hasVideo() {
+            return conn.hasVideoChannel(displayId);
+        }
+
+        @Override
+        public void bindVideoSocket(Socket socket) throws IOException {
+            conn.bindVideoSocket(displayId, socket);
+        }
+    }
+
+    public int getSessionId() {
+        return sessionId;
+    }
+
+    public void shutdown() {
+        exited.set(true);
+        cleanup();
+    }
+
+    private void cleanup() {
+        if (!cleanedUp.compareAndSet(false, true)) {
+            return; // 已清理
+        }
+        exited.set(true);
+        phase = Phase.CLOSED;
+        configuredLatch.countDown();
+
+        // 释放本会话持有的全部 VD 引用。
+        registry.releaseSession(sessionId);
+        // 释放本会话持有的全部视频订阅者。这是幂等安全网（丢弃每个
+        // (sessionId, displayId) 订阅并关闭随之变空的 broadcaster）；下面每个控制器的
+        // stopVideoInternal() 也会释放自己的订阅者，因 releaseSubscriber 幂等而无副作用。
+        broadcasterRegistry.releaseSession(sessionId);
+
+        // 停止所有 per-display 视频控制器。stopVideoInternal() 同时释放控制器自身的
+        // 订阅者并拆除 releaseSession() 不管的控制器/会话资源。
+        // 与 onVideoSocket/configure 的创建路径共用 videoControllers 监视器，
+        // 防止并发创建的控制器逃过清理（create 路径受 exited 检查兜底）。
+        List<SessionVideoController> videoCopy;
+        synchronized (videoControllers) {
+            videoCopy = new ArrayList<>(videoControllers.values());
+            videoControllers.clear();
+        }
+        for (SessionVideoController vc : videoCopy) {
+            vc.stopVideoInternal();
+        }
+
+        // 停止所有 per-display controller 及其控制循环。
+        List<Controller> ctrlCopy = new ArrayList<>(controllers.values());
+        controllers.clear();
+        List<ControlLoopRunner> runnerCopy = new ArrayList<>(controlLoopRunners.values());
+        controlLoopRunners.clear();
+        for (Controller c : ctrlCopy) {
+            c.stop();
+        }
+
+        // 先关 socket 再 join：Thread.interrupt() 无法唤醒阻塞在 InputStream.read() 的
+        // 线程，只有当对端未发 FIN（半开连接）时先关闭通道，下面的 join 才能返回。
+        connection.shutdown();
+        connection.close();
+
+        for (ControlLoopRunner r : runnerCopy) {
+            joinControlLoop(r, STOP_JOIN_TIMEOUT_MS, "cleanup");
+        }
+        for (Controller c : ctrlCopy) {
+            try {
+                c.join();
+            } catch (InterruptedException ignored) {
+                Thread.currentThread().interrupt();
+            }
+        }
+
+        if (server != null) {
+            server.removeSession(sessionId);
+        }
+    }
+
+    /** 带超时 join 控制循环线程；超时仍在运行则告警并放弃（泄漏的 daemon 线程由 JVM 托管）。 */
+    private void joinControlLoop(ControlLoopRunner runner, long timeoutMs, String context) {
+        try {
+            runner.join(timeoutMs);
+            Thread t = runner.getThread();
+            if (t != null && t.isAlive()) {
+                Ln.e(tag + ": control loop thread " + t.getName() + " (" + context + ")"
+                        + " still alive after " + timeoutMs + "ms; leaking daemon thread");
+            }
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        }
+    }
+}
