+package com.genymobile.scrcpy.video;
+
+import android.hardware.display.VirtualDisplay;
+import android.view.Surface;
+
+import com.genymobile.scrcpy.model.Size;
+
+public interface ExternalDisplayProvider {
+    VirtualDisplay get(int displayId);
+    void restore(int displayId);
+
+    /**
+     * Bind an external (non-fallback) surface — typically the encoder's MediaCodec
+     * input surface — to the virtual display and record it in the session. While an
+     * external surface is bound, resize must keep the ImageReader untouched (the
+     * reader is only a fallback consumer).
+     *
+     * @return {@code true} if the surface was bound and recorded, {@code false} if the
+     *         binding failed (no surface is recorded in that case, so callers must not
+     *         treat the display as externally driven)
+     */
+    default boolean markExternalSurface(int displayId, Surface surface) {
+        // Default no-op for providers that do not track surfaces.
+        return true;
+    }
+
+    /**
+     * Size the display was last actually resized to, or null when unknown. Long-lived
+     * (per-display) cache: lets callers skip resize on session rebind when the size is
+     * already current. Default no-op for providers that do not track sizes.
+     */
+    default Size getBoundedSize(int displayId) {
+        return null;
+    }
+
+    default void setBoundedSize(int displayId, Size size) {
+        // Default no-op for providers that do not track sizes.
+    }
+}
