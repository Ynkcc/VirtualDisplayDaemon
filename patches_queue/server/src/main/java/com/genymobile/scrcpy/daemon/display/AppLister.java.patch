+package com.genymobile.scrcpy.daemon.display;
+
+import com.genymobile.scrcpy.FakeContext;
+import com.genymobile.scrcpy.model.DeviceApp;
+import com.genymobile.scrcpy.util.Ln;
+
+import android.content.Intent;
+import android.content.pm.ActivityInfo;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.content.res.AssetManager;
+import android.content.res.Configuration;
+import android.content.res.Resources;
+import android.util.DisplayMetrics;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+public final class AppLister {
+
+    private AppLister() {
+    }
+
+    /**
+     * List installed apps on the device that have a launch intent.
+     *
+     * <p>Returns a snapshot sorted by package name. Filters out pure system
+     * packages (no launcher intent) so the remote AppSelectionDialog matches
+     * what a local launcher would show.
+     */
+    public static List<DeviceApp> listInstalledApps() {
+        try {
+            PackageManager pm = FakeContext.get().getPackageManager();
+            List<ApplicationInfo> all = pm.getInstalledApplications(PackageManager.GET_META_DATA);
+            List<DeviceApp> result = new ArrayList<>(all.size());
+            for (ApplicationInfo info : all) {
+                // Filter: keep non-system apps, or system apps that expose a
+                // launch intent (e.g. Settings).
+                boolean isSystem = (info.flags & ApplicationInfo.FLAG_SYSTEM) != 0;
+                Intent launchIntent = pm.getLaunchIntentForPackage(info.packageName);
+                if (launchIntent == null) {
+                    launchIntent = pm.getLeanbackLaunchIntentForPackage(info.packageName);
+                }
+                if (launchIntent == null) {
+                    continue;
+                }
+                result.add(new DeviceApp(info.packageName, resolveAppName(pm, info, launchIntent), isSystem));
+            }
+            Collections.sort(result, (a, b) -> a.getName().compareToIgnoreCase(b.getName()));
+            return result;
+        } catch (Exception e) {
+            Ln.e("AppLister: failed to list installed apps", e);
+            return Collections.emptyList();
+        }
+    }
+
+    /**
+     * Resolve the best display name for an app.
+     *
+     * <p>Prefer the application label; fall back to the launcher activity's
+     * label when the former is missing. This avoids showing raw package names
+     * or class names for apps that only declare a label on their launcher
+     * activity.
+     */
+    private static String resolveAppName(PackageManager pm, ApplicationInfo info, Intent launchIntent) {
+        String appLabel = loadApplicationLabel(pm, info);
+        if (!appLabel.isEmpty()) {
+            return appLabel;
+        }
+        try {
+            ResolveInfo ri = pm.resolveActivity(launchIntent, PackageManager.MATCH_DEFAULT_ONLY);
+            if (ri != null && ri.activityInfo != null) {
+                String s = loadActivityLabel(pm, ri.activityInfo, info.packageName);
+                if (!s.isEmpty()) {
+                    return s;
+                }
+            }
+        } catch (Exception e) {
+            Ln.w("AppLister: failed to resolve launcher label for " + info.packageName, e);
+        }
+        return info.packageName;
+    }
+
+    /**
+     * Resolve the application label, trying in order: an inline string label,
+     * {@link ApplicationInfo#loadLabel}, then the string resource referenced by
+     * {@code labelRes}.
+     *
+     * <p>loadLabel()/getText() can fail for large apps whose code cannot be
+     * loaded (CONTEXT_INCLUDE_CODE) and then falls back to the application
+     * class name ({@link ApplicationInfo#name}) or the package name; those
+     * fallbacks are treated as "no label". The string resource is loaded
+     * straight from the APK's resource table via {@link AssetManager}, which
+     * does not depend on the (fabricated) activity-thread context the daemon
+     * runs under, so it works even when the app code cannot be loaded.
+     *
+     * @return the resolved label, or an empty string when no real label exists
+     */
+    private static String loadApplicationLabel(PackageManager pm, ApplicationInfo info) {
+        if (info.nonLocalizedLabel != null) {
+            String s = info.nonLocalizedLabel.toString().trim();
+            if (!s.isEmpty()) {
+                return s;
+            }
+        }
+        CharSequence label = info.loadLabel(pm);
+        String s = label != null ? label.toString().trim() : "";
+        if (!s.isEmpty() && !s.equals(info.packageName) && !s.equals(info.name)) {
+            return s;
+        }
+        if (info.labelRes != 0) {
+            // Prefer the framework path (valid in a real instrumentation context).
+            try {
+                String rs = pm.getResourcesForApplication(info).getString(info.labelRes);
+                if (rs != null && !rs.trim().isEmpty()) {
+                    return rs.trim();
+                }
+            } catch (Exception e) {
+                Ln.w("AppLister: failed to load label resource for " + info.packageName, e);
+            }
+            // Fall back to reading the APK resource table directly. This is the
+            // reliable path under the daemon's fabricated context.
+            String fromApk = loadLabelFromApk(info);
+            if (!fromApk.isEmpty()) {
+                return fromApk;
+            }
+        }
+        return "";
+    }
+
+    /**
+     * Load a string resource straight from the APK file via a standalone
+     * {@link AssetManager}. This bypasses PackageManager/Context entirely, so
+     * it is immune to the daemon's fabricated activity-thread environment and
+     * does not require loading the app's code.
+     *
+     * @return the resolved label, or an empty string on any failure
+     */
+    @SuppressWarnings("deprecation")
+    private static String loadLabelFromApk(ApplicationInfo info) {
+        AssetManager am = null;
+        try {
+            // AssetManager() and addAssetPath() are hidden API on modern
+            // Android, so build the manager reflectively.
+            Class<?> assetManagerClass = AssetManager.class;
+            java.lang.reflect.Constructor<?> ctor = assetManagerClass.getDeclaredConstructor();
+            ctor.setAccessible(true);
+            am = (AssetManager) ctor.newInstance();
+            java.lang.reflect.Method addAssetPath = assetManagerClass.getMethod("addAssetPath", String.class);
+            addAssetPath.invoke(am, info.sourceDir);
+            DisplayMetrics dm = Resources.getSystem().getDisplayMetrics();
+            Configuration config = Resources.getSystem().getConfiguration();
+            Resources res = new Resources(am, dm, config);
+            String s = res.getString(info.labelRes);
+            if (s != null) {
+                s = s.trim();
+            }
+            return s != null && !s.isEmpty() ? s : "";
+        } catch (Exception e) {
+            Ln.w("AppLister: failed to load label from APK for " + info.packageName, e);
+            return "";
+        } finally {
+            if (am != null) {
+                try {
+                    am.close();
+                } catch (Exception ignored) {
+                    // best-effort close
+                }
+            }
+        }
+    }
+
+    /**
+     * Resolve an activity's label, rejecting the synthetic fallbacks that
+     * {@link ActivityInfo#loadLabel} produces when no {@code android:label} is
+     * declared: the fully-qualified activity class name ({@link ActivityInfo#name})
+     * or the package name.
+     *
+     * @return the resolved label, or an empty string when it is only a fallback
+     */
+    private static String loadActivityLabel(PackageManager pm, ActivityInfo ai, String packageName) {
+        CharSequence label = ai.loadLabel(pm);
+        String s = label != null ? label.toString().trim() : "";
+        if (s.isEmpty() || s.equals(ai.name) || s.equals(packageName)) {
+            return "";
+        }
+        return s;
+    }
+}
