+package com.genymobile.scrcpy.daemon.net;
+
+import com.genymobile.scrcpy.control.ControlChannel;
+import com.genymobile.scrcpy.util.IO;
+import com.genymobile.scrcpy.util.Ln;
+import com.genymobile.scrcpy.util.StringUtils;
+
+import java.io.Closeable;
+import java.io.DataInputStream;
+import java.io.FileDescriptor;
+import java.io.IOException;
+import java.io.InputStream;
+import java.lang.reflect.Field;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * 单个客户端会话的全部 socket 通道。
+ *
+ * <p>握手格式：
+ * <pre>
+ *   +--------+--------------------------+--------------------------+
+ *   | 1 byte | 4 bytes (仅 NEGOTIATION) | 4 bytes (其余 role)      |
+ *   | role   | sessionId                | displayId                |
+ *   +--------+--------------------------+--------------------------+
+ * </pre>
+ * ROLE_VIDEO / ROLE_AUDIO / ROLE_CONTROL 在 sessionId 后追加 4 字节大端 {@code displayId}，
+ * 使单个会话可为不同显示器打开 N 个同类型 role socket。ROLE_NEGOTIATION 是会话级控制面，
+ * 不带 displayId。
+ *
+ * <p>通道以 {@code (role, displayId)} 为键存放在单张表中，用同一把锁保护；同键重复绑定
+ * 会替换并关闭旧 socket（重连语义）。
+ */
+public final class TcpDesktopConnection implements Closeable {
+
+    public static final int ROLE_VIDEO = 0;
+    public static final int ROLE_AUDIO = 1;
+    public static final int ROLE_CONTROL = 2;
+    public static final int ROLE_NEGOTIATION = 3;
+
+    private static final int DEVICE_NAME_FIELD_LENGTH = 64;
+    private static final int MAX_TOKEN_BYTES = 1024;
+
+    /**
+     * 从 accept() 到 role/session/displayId 握手完成期间的读超时。没有它，端口扫描或
+     * 握手途中断连的对端会永久阻塞接受线程。进入数据阶段后由
+     * {@link #clearSoTimeout(Socket)} 清零。
+     */
+    public static final int HANDSHAKE_SO_TIMEOUT_MS = 10000;
+
+    /** (role, displayId) 复合键。 */
+    public static final class RoleDisplayKey {
+        public final int role;
+        public final int displayId;
+
+        public RoleDisplayKey(int role, int displayId) {
+            this.role = role;
+            this.displayId = displayId;
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            if (this == o) {
+                return true;
+            }
+            if (!(o instanceof RoleDisplayKey)) {
+                return false;
+            }
+            RoleDisplayKey that = (RoleDisplayKey) o;
+            return role == that.role && displayId == that.displayId;
+        }
+
+        @Override
+        public int hashCode() {
+            return 31 * role + displayId;
+        }
+
+        @Override
+        public String toString() {
+            String roleName;
+            switch (role) {
+                case ROLE_VIDEO:
+                    roleName = "VIDEO";
+                    break;
+                case ROLE_AUDIO:
+                    roleName = "AUDIO";
+                    break;
+                case ROLE_CONTROL:
+                    roleName = "CONTROL";
+                    break;
+                default:
+                    roleName = "ROLE_" + role;
+                    break;
+            }
+            return roleName + ":displayId=" + displayId;
+        }
+    }
+
+    /** 一个 role 通道：socket 及（video/audio 时）其文件描述符。 */
+    private static final class Channel {
+        private final Socket socket;
+        private final FileDescriptor fd;
+        private final ControlChannel controlChannel;
+
+        Channel(Socket socket, FileDescriptor fd, ControlChannel controlChannel) {
+            this.socket = socket;
+            this.fd = fd;
+            this.controlChannel = controlChannel;
+        }
+    }
+
+    private final Socket negotiationSocket;
+    private final ControlChannel negotiationChannel;
+    private final Map<RoleDisplayKey, Channel> channels = new HashMap<>();
+    private final int sessionId;
+
+    public TcpDesktopConnection(Socket negotiationSocket, int sessionId) throws IOException {
+        this.negotiationSocket = negotiationSocket;
+        this.sessionId = sessionId;
+        this.negotiationChannel = negotiationSocket != null
+                ? new ControlChannel(negotiationSocket.getInputStream(), negotiationSocket.getOutputStream())
+                : null;
+    }
+
+    public ControlChannel getNegotiationChannel() {
+        return negotiationChannel;
+    }
+
+    public int getSessionId() {
+        return sessionId;
+    }
+
+    // ------------------------------------------------------------------
+    // 绑定 / 访问
+    // ------------------------------------------------------------------
+
+    public ControlChannel bindControlSocket(int displayId, Socket socket) throws IOException {
+        RoleDisplayKey key = new RoleDisplayKey(ROLE_CONTROL, displayId);
+        synchronized (channels) {
+            closeQuietly(removeChannelLocked(key));
+            ControlChannel ch = new ControlChannel(socket.getInputStream(), socket.getOutputStream());
+            channels.put(key, new Channel(socket, null, ch));
+            Ln.d("TcpDesktopConnection[" + sessionId + "]: control socket bound " + key);
+            return ch;
+        }
+    }
+
+    public void bindVideoSocket(int displayId, Socket socket) throws IOException {
+        bindFdSocket(ROLE_VIDEO, displayId, socket);
+    }
+
+    public void bindAudioSocket(int displayId, Socket socket) throws IOException {
+        bindFdSocket(ROLE_AUDIO, displayId, socket);
+    }
+
+    private void bindFdSocket(int role, int displayId, Socket socket) throws IOException {
+        RoleDisplayKey key = new RoleDisplayKey(role, displayId);
+        FileDescriptor fd = getFileDescriptor(socket);
+        synchronized (channels) {
+            closeQuietly(removeChannelLocked(key));
+            channels.put(key, new Channel(socket, fd, null));
+            Ln.d("TcpDesktopConnection[" + sessionId + "]: " + key + " bound, fd=" + fd);
+        }
+    }
+
+    public boolean hasVideoChannel(int displayId) {
+        synchronized (channels) {
+            return channels.containsKey(new RoleDisplayKey(ROLE_VIDEO, displayId));
+        }
+    }
+
+    public FileDescriptor getVideoFd(int displayId) {
+        synchronized (channels) {
+            Channel ch = channels.get(new RoleDisplayKey(ROLE_VIDEO, displayId));
+            return ch != null ? ch.fd : null;
+        }
+    }
+
+    /** 移除并返回同键旧通道的 socket（须在锁内调用）。 */
+    private Socket removeChannelLocked(RoleDisplayKey key) {
+        Channel prev = channels.remove(key);
+        return prev != null ? prev.socket : null;
+    }
+
+    // ------------------------------------------------------------------
+    // Shutdown / close
+    // ------------------------------------------------------------------
+
+    /** 半关闭所有 socket（发送 FIN），使对端的阻塞读能返回 EOF。 */
+    public void shutdown() {
+        shutdownSocket(negotiationSocket);
+        for (Socket socket : snapshotSockets()) {
+            shutdownSocket(socket);
+        }
+    }
+
+    @Override
+    public void close() {
+        closeQuietly(negotiationSocket);
+        List<Socket> all;
+        synchronized (channels) {
+            all = new ArrayList<>(channels.size());
+            for (Channel ch : channels.values()) {
+                all.add(ch.socket);
+            }
+            channels.clear();
+        }
+        for (Socket socket : all) {
+            closeQuietly(socket);
+        }
+    }
+
+    private List<Socket> snapshotSockets() {
+        synchronized (channels) {
+            List<Socket> sockets = new ArrayList<>(channels.size());
+            for (Channel ch : channels.values()) {
+                sockets.add(ch.socket);
+            }
+            return sockets;
+        }
+    }
+
+    // ------------------------------------------------------------------
+    // 设备元数据
+    // ------------------------------------------------------------------
+
+    public void sendDeviceMeta(String deviceName) throws IOException {
+        if (negotiationSocket == null) {
+            throw new IOException("No negotiation socket available to send device metadata");
+        }
+        byte[] buffer = new byte[DEVICE_NAME_FIELD_LENGTH];
+        byte[] deviceNameBytes = deviceName.getBytes(StandardCharsets.UTF_8);
+        int len = StringUtils.getUtf8TruncationIndex(deviceNameBytes, DEVICE_NAME_FIELD_LENGTH - 1);
+        System.arraycopy(deviceNameBytes, 0, buffer, 0, len);
+        FileDescriptor fd = getFileDescriptor(negotiationSocket);
+        if (fd == null) {
+            throw new IOException("Could not get file descriptor for device metadata transmission");
+        }
+        IO.writeFully(fd, buffer, 0, buffer.length);
+    }
+
+    // ------------------------------------------------------------------
+    // 握手原语
+    // ------------------------------------------------------------------
+
+    /** 读取所有 socket 类型共用的 1 字节 role 头。 */
+    public static int readSocketRole(Socket socket) throws IOException {
+        InputStream in = socket.getInputStream();
+        int role = in.read();
+        if (role < 0) {
+            throw new IOException("Connection closed before role byte received");
+        }
+        if (role != ROLE_VIDEO && role != ROLE_AUDIO && role != ROLE_CONTROL && role != ROLE_NEGOTIATION) {
+            throw new IOException("Invalid socket role: " + role);
+        }
+        return role;
+    }
+
+    /** 离开握手阶段：清除握手读超时，使 socket 可在数据交换期间任意长时间空闲。 */
+    public static void clearSoTimeout(Socket socket) {
+        try {
+            socket.setSoTimeout(0);
+        } catch (java.net.SocketException e) {
+            Ln.w("Failed to clear soTimeout after handshake: " + e.getMessage());
+        }
+    }
+
+    public static void writeSessionId(Socket socket, int sessionId) throws IOException {
+        DaemonWire.writeInt32(socket.getOutputStream(), sessionId);
+    }
+
+    public static int readSessionId(Socket socket) throws IOException {
+        return DaemonWire.readInt32(socket.getInputStream());
+    }
+
+    /** 校验客户端出示的密钥；使用常量时间比较避免时序侧信道。 */
+    public static boolean authenticate(Socket socket, String expectedToken) throws IOException {
+        DataInputStream in = new DataInputStream(socket.getInputStream());
+        int len = DaemonWire.readInt32(in);
+        if (len < 0 || len > MAX_TOKEN_BYTES) {
+            return false;
+        }
+        byte[] buf = new byte[len];
+        in.readFully(buf);
+        return MessageDigest.isEqual(expectedToken.getBytes(StandardCharsets.UTF_8), buf);
+    }
+
+    /** role socket 被正确路由的确认：服务端回写 4 字节大端 displayId。 */
+    public static void writeDisplayId(Socket socket, int displayId) throws IOException {
+        DaemonWire.writeInt32(socket.getOutputStream(), displayId);
+    }
+
+    /** 读取客户端声明的 displayId。 */
+    public static int readDisplayId(Socket socket) throws IOException {
+        return DaemonWire.readInt32(socket.getInputStream());
+    }
+
+    // ------------------------------------------------------------------
+    // Helpers
+    // ------------------------------------------------------------------
+
+    private static FileDescriptor getFileDescriptor(Socket socket) {
+        try {
+            Field implField = Socket.class.getDeclaredField("impl");
+            implField.setAccessible(true);
+            Object socketImpl = implField.get(socket);
+            Class<?> socketImplClass = socketImpl.getClass();
+            while (socketImplClass != null) {
+                try {
+                    Field fdField = socketImplClass.getDeclaredField("fd");
+                    fdField.setAccessible(true);
+                    return (FileDescriptor) fdField.get(socketImpl);
+                } catch (NoSuchFieldException e) {
+                    socketImplClass = socketImplClass.getSuperclass();
+                }
+            }
+            Ln.w("getFileDescriptor: could not find 'fd' field in Socket.impl hierarchy");
+        } catch (Exception e) {
+            Ln.w("getFileDescriptor: reflection failed, video/audio streaming may not work", e);
+        }
+        return null;
+    }
+
+    public static void shutdownSocket(Socket socket) {
+        if (socket == null) {
+            return;
+        }
+        try {
+            socket.shutdownInput();
+            socket.shutdownOutput();
+        } catch (IOException e) {
+            Ln.d("Socket shutdown failed: " + e.getMessage());
+        }
+    }
+
+    public static void closeQuietly(Socket socket) {
+        if (socket == null) {
+            return;
+        }
+        try {
+            socket.close();
+        } catch (IOException e) {
+            Ln.d("Socket close failed: " + e.getMessage());
+        }
+    }
+}
