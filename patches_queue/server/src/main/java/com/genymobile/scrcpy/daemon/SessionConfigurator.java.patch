+package com.genymobile.scrcpy.daemon;
+
+import com.genymobile.scrcpy.daemon.net.TcpDesktopConnection;
+
+import java.util.List;
+
+/**
+ * 让协商阶段的 {@code DaemonCommandHandler} 把会话级 scrcpy 选项覆盖推回所属
+ * {@link ClientSession}。
+ *
+ * <p>{@code TYPE_CONFIGURE_SESSION} 是客户端在收到 sessionId + device meta 后发送的第一条
+ * 消息。handler 通过本接口回调，使会话能在任何 ROLE_VIDEO / ROLE_AUDIO / ROLE_CONTROL
+ * socket 打开之前重建 per-session {@code Options}——即"先协商、后开 socket"。
+ *
+ * <p>只有协商通道的 handler 会注入非 null 的 configurator；控制通道传 {@code null}，
+ * 使控制通道上的 CONFIGURE 被拒绝而非静默忽略。
+ */
+public interface SessionConfigurator {
+
+    /**
+     * 应用客户端提供的 scrcpy 选项覆盖，并声明客户端将打开的 (role, displayId) socket 集合。
+     *
+     * <p>{@code rolesEntries} 枚举客户端承诺绑定的精确 (role, displayId) 对；未列出者会被
+     * 会话门禁拒绝。
+     *
+     * @param optionsKv       newline 分隔的 {@code key=value}（scrcpy 选项键），不会为 null
+     * @param legacyRolesMask 兼容用的 3-bit role mask（bit0 video/bit1 audio/bit2 control），
+     *                        0 表示未声明
+     * @param rolesEntries    显式 (role, displayId) 声明；为空则回退到 mask
+     * @throws Exception 选项非法或视频已启动
+     */
+    void configure(String optionsKv, int legacyRolesMask,
+                   List<TcpDesktopConnection.RoleDisplayKey> rolesEntries) throws Exception;
+}
