+package com.genymobile.scrcpy.daemon.video;
+
+import com.genymobile.scrcpy.Options;
+import com.genymobile.scrcpy.control.Controller;
+import com.genymobile.scrcpy.daemon.core.DaemonArgs;
+import com.genymobile.scrcpy.daemon.display.DisplaySurfaceBroker;
+import com.genymobile.scrcpy.daemon.display.RefCountedDisplayRegistry;
+import com.genymobile.scrcpy.util.Ln;
+
+import java.io.FileDescriptor;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * 按 {@code displayId} 分组的引用计数 {@link FrameBroadcaster} 注册表：首个订阅者到来时
+ * 创建 broadcaster，最后一个订阅者离开时拆除。
+ *
+ * <p>它与 {@code VirtualDisplayRegistry} 的 VD 引用计数相互独立：后者管 VD 生命周期
+ * （创建者 + 串流者），本类管 encoder/broadcaster 生命周期（订阅者）。VD 可在零订阅者时
+ * 存活，而 broadcaster 会随订阅者重新出现而重建。
+ *
+ * <p>per-session 引用计数与 {@link #lock} 均继承自 {@link RefCountedDisplayRegistry}。
+ *
+ * <h3>并发</h3>
+ * get-or-create / subscribe / unsubscribe / remove 的判定都在 {@link #lock} 内完成，使
+ * "最后一个订阅者离开→关闭"与"新订阅者到来→复用"保持原子。重 I/O
+ * （{@link FrameBroadcaster#shutdown}）在锁外执行。锁序严格为 registry → broadcaster，
+ * 且 broadcaster 不会在持有自身锁时回调 registry，故无死锁。
+ */
+public final class FrameBroadcasterRegistry extends RefCountedDisplayRegistry {
+
+    private final DisplaySurfaceBroker broker;
+    private final Map<Integer, FrameBroadcaster> broadcasters = new HashMap<>();
+
+    public FrameBroadcasterRegistry(DisplaySurfaceBroker broker) {
+        this.broker = broker;
+    }
+
+    /**
+     * 将 {@code sessionId} 订阅到 {@code displayId} 的 broadcaster（必要时创建）。
+     *
+     * <p>首个订阅者的 {@code options} / {@code baseArgs} 会固化进共享 encoder；后续订阅者
+     * 复用运行中的 broadcaster，其自身 options 被忽略，并以 warning 记录，避免 per-session
+     * 选项不一致被静默吞掉。
+     *
+     * @param displayId  目标虚拟显示器
+     * @param sessionId  订阅的客户端会话
+     * @param videoFd    会话的视频 socket 文件描述符
+     * @param options    per-session scrcpy options（仅在创建 broadcaster 时使用）
+     * @param baseArgs   per-session 已清洗 scrcpy 参数（仅在创建时使用）
+     * @param controller 会话 controller（仅在创建时作为 {@code VirtualDisplayListener}），可为 null
+     * @return 订阅者句柄，由调用方持有，经 {@link #releaseSubscriber} 或 {@link #releaseSession} 释放
+     */
+    public VideoSubscriber acquireSubscriber(int displayId, int sessionId, FileDescriptor videoFd,
+                                             Options options, String[] baseArgs, Controller controller) throws Exception {
+        // Options.parse（含 display_id 改写）在锁外完成：解析涉及大量字符串处理，
+        // 放在 registry 锁内会串行化所有 display 的注册表操作。
+        Options captureOptions = Options.parse(DaemonArgs.changeDisplayId(baseArgs, displayId));
+        synchronized (lock) {
+            FrameBroadcaster b = broadcasters.get(displayId);
+            boolean created;
+            if (b != null) {
+                created = false;
+            } else {
+                // create() 现在只做对象构造与异步编码线程启动（无参数解析、无阻塞 I/O），
+                // 因此在锁内完成 get-or-create 是安全的，并与 release/teardown 保持原子。
+                b = FrameBroadcaster.create(displayId, options, captureOptions, broker, controller);
+                broadcasters.put(displayId, b);
+                created = true;
+            }
+            if (!created) {
+                Ln.w("Daemon: session " + sessionId + " reused the running broadcaster for"
+                        + " displayId=" + displayId + " — its options are ignored (first subscriber's options apply)");
+            }
+            acquireRef(displayId, sessionId);
+            // 在锁内 subscribe，使其相对并发的 releaseSubscriber 原子（否则后者可能在
+            // get() 与 subscribe() 之间关掉 broadcaster）。
+            VideoSubscriber sub = b.subscribe(sessionId, videoFd);
+            Ln.i("Daemon: session " + sessionId + " subscribed to displayId=" + displayId
+                    + " (created=" + created + ", subscribers=" + b.subscriberCount() + ")");
+            return sub;
+        }
+    }
+
+    /**
+     * 释放指定订阅者。若它是其 displayId 的最后一个订阅者，则关闭 broadcaster
+     * （停止 encoder、恢复 VD 兜底 surface），但不销毁 VD 本身。
+     *
+     * <p><b>幂等：</b>在 {@link #releaseSession(sessionId)} 已丢弃该会话订阅后调用是安全的
+     * ——会话不再持有引用，且 (sub, sessionId) 已从 broadcaster 移除，调用退化为 no-op。
+     * {@code ClientSession.cleanup()} 正是依赖此契约：先以 releaseSession() 兜底，再逐个
+     * 停止 per-display 视频控制器（各自释放自己的订阅者）。
+     */
+    public void releaseSubscriber(int displayId, int sessionId, VideoSubscriber sub) {
+        FrameBroadcaster toShutdown = null;
+        synchronized (lock) {
+            FrameBroadcaster b = broadcasters.get(displayId);
+            if (b != null) {
+                b.unsubscribe(sub);
+                // Release the session's reference; if this was the last user across all
+                // sessions, tear the broadcaster down.
+                if (releaseRef(displayId, sessionId)) {
+                    broadcasters.remove(displayId);
+                    toShutdown = b;
+                }
+            }
+        }
+        if (toShutdown != null) {
+            toShutdown.shutdown();
+        }
+    }
+
+    /**
+     * Release every subscriber held by a session. Called from
+     * {@code ClientSession.cleanup()} as a safety net so a disconnecting client
+     * never orphans a subscriber (mirrors {@code VirtualDisplayRegistry.releaseSession}).
+     */
+    public void releaseSession(int sessionId) {
+        List<Integer> affected;
+        List<FrameBroadcaster> toShutdown = new ArrayList<>();
+        synchronized (lock) {
+            // Drop the session's references; affected = every display this session subscribed to.
+            affected = releaseSessionRefs(sessionId);
+            for (int displayId : affected) {
+                FrameBroadcaster b = broadcasters.get(displayId);
+                if (b != null) {
+                    // Remove this session's subscriber(s) from the broadcaster regardless of
+                    // whether other sessions remain.
+                    b.unsubscribeBySession(sessionId);
+                    // Only shut the broadcaster down if no session references it any more.
+                    if (!hasUsers(displayId)) {
+                        broadcasters.remove(displayId);
+                        toShutdown.add(b);
+                    }
+                }
+            }
+        }
+        for (FrameBroadcaster b : toShutdown) {
+            b.shutdown();
+        }
+        if (!affected.isEmpty()) {
+            Ln.i("Daemon: released session " + sessionId
+                    + " subscribers on displayIds=" + affected
+                    + (!toShutdown.isEmpty() ? " (broadcasters shut down)" : ""));
+        }
+    }
+
+    /**
+     * Wire {@code controller} as the VirtualDisplayListener of the broadcaster
+     * for {@code displayId} (if one exists). Fixes video-first ordering where
+     * the broadcaster was created before any control socket existed.
+     */
+    public void attachListener(int displayId, Controller controller) {
+        FrameBroadcaster b;
+        synchronized (lock) {
+            b = broadcasters.get(displayId);
+        }
+        if (b != null) {
+            b.setController(controller);
+        }
+    }
+
+    /**
+     * Tear down the broadcaster for {@code displayId} unconditionally, regardless
+     * of remaining session refs. Used when the underlying virtual display is
+     * destroyed (TYPE_RELEASE_VIRTUAL_DISPLAY): the encoder cannot keep running
+     * from a dead surface. Broadcaster lifetime is encoder-side bookkeeping only;
+     * display refcounts (RefCountedDisplayRegistry users) are untouched.
+     */
+    public void releaseDisplay(int displayId) {
+        FrameBroadcaster toShutdown;
+        synchronized (lock) {
+            toShutdown = broadcasters.remove(displayId);
+        }
+        if (toShutdown != null) {
+            toShutdown.shutdown();
+            Ln.i("Daemon: released broadcaster for displayId=" + displayId + " (display destroyed)");
+        }
+    }
+
+    /**
+     * Kick the shared encoder for a displayId (e.g. after a VD resize) so it
+     * rebuilds at the new dimensions and re-emits session meta to all
+     * subscribers.
+     */
+    public void kick(int displayId, int resetReasons) {
+        FrameBroadcaster b;
+        synchronized (lock) {
+            b = broadcasters.get(displayId);
+        }
+        if (b != null) {
+            b.kick(resetReasons);
+        } else {
+            Ln.w("Daemon: kick for displayId=" + displayId
+                    + " — no active broadcaster (nothing to reset)");
+        }
+    }
+
+    /** Release all broadcasters. Called from {@code DaemonServer.shutdown()}. */
+    public void releaseAll() {
+        List<FrameBroadcaster> all;
+        synchronized (lock) {
+            all = new ArrayList<>(broadcasters.values());
+            broadcasters.clear();
+            clearUsers();
+        }
+        for (FrameBroadcaster b : all) {
+            b.shutdown();
+        }
+        Ln.i("Daemon: released all broadcasters (" + all.size() + ")");
+    }
+}
