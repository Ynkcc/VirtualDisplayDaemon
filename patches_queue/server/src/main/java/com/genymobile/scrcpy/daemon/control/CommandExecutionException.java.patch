+package com.genymobile.scrcpy.daemon.control;
+
+/**
+ * Business-level error from a daemon command handler.
+ *
+ * <p>Previously handlers signalled failure by throwing {@link RuntimeException},
+ * which required a blanket {@code catch (Throwable)} in the dispatcher. This
+ * typed exception lets the dispatcher distinguish intentional business errors
+ * from genuine programmer mistakes and propagate {@link Error} / unexpected
+ * exceptions correctly.
+ */
+public class CommandExecutionException extends Exception {
+
+    private final int code;
+
+    public CommandExecutionException(int code, String message) {
+        super(message);
+        this.code = code;
+    }
+
+    public CommandExecutionException(String message) {
+        this(-1, message);
+    }
+
+    public CommandExecutionException(Throwable cause) {
+        super(cause);
+        this.code = -1;
+    }
+
+    public int getCode() {
+        return code;
+    }
+}
