+package com.genymobile.scrcpy.daemon.core;
+
+import com.genymobile.scrcpy.AsyncProcessor;
+import com.genymobile.scrcpy.control.Controller;
+import com.genymobile.scrcpy.util.Ln;
+
+/**
+ * Runs the {@link Controller} control loop on a dedicated thread.
+ *
+ * <p>Encapsulates the {@code ctrlThread} management previously inlined in
+ * {@code ClientSession.run()}, so the session orchestrator only deals with
+ * start/join/stop and a termination callback.
+ */
+public final class ControlLoopRunner {
+
+    private final int sessionId;
+    private final String tag;
+    private Thread thread;
+
+    public ControlLoopRunner(int sessionId) {
+        this.sessionId = sessionId;
+        this.tag = DaemonLog.tag(sessionId);
+    }
+
+    /**
+     * Start the control loop. The {@code controller} runs on a daemon thread named
+     * {@code ctrl-<sessionId>}; on termination {@code onTerminated} is invoked.
+     */
+    public void start(Controller controller, AsyncProcessor.TerminationListener onTerminated) {
+        thread = new Thread(() -> {
+            try {
+                Ln.i(tag + ": calling controller.start()");
+                controller.start(onTerminated);
+                Ln.i(tag + ": controller.start() returned, joining...");
+                controller.join();
+                Ln.i(tag + ": controller.join() returned");
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } catch (Throwable t) {
+                Ln.e(tag + ": ctrlThread error", t);
+            }
+        }, "ctrl-" + sessionId);
+        thread.setDaemon(true);
+        thread.start();
+    }
+
+    public void join() throws InterruptedException {
+        if (thread != null) {
+            thread.join();
+            Ln.i(tag + ": ctrlThread.join() returned");
+        }
+    }
+
+    /**
+     * Join the control thread with a timeout. Returns normally whether the
+     * thread exited or is still alive; callers should check
+     * {@link #getThread()#isAlive()} to detect a leak.
+     *
+     * @param timeoutMillis maximum wait time
+     */
+    public void join(long timeoutMillis) throws InterruptedException {
+        if (thread != null) {
+            thread.join(timeoutMillis);
+        }
+    }
+
+    /** The underlying thread (null until {@link #start} is called). */
+    public Thread getThread() {
+        return thread;
+    }
+}
