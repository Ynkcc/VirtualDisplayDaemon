+package com.genymobile.scrcpy.daemon.display;
+
+import com.genymobile.scrcpy.daemon.compat.DisplayCompat;
+import com.genymobile.scrcpy.display.DisplayInfo;
+import com.genymobile.scrcpy.util.Ln;
+import com.genymobile.scrcpy.wrappers.ServiceManager;
+
+import android.graphics.PixelFormat;
+import android.hardware.display.VirtualDisplay;
+import android.media.ImageReader;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.view.Surface;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+public final class VirtualDisplayRegistry extends RefCountedDisplayRegistry {
+
+    public static final int PERSISTENT_SESSION_ID = -1;
+
+    private static final int IMAGE_READER_MAX_IMAGES = 5; // larger buffer to reduce frame drops
+
+    private final Map<Integer, VirtualDisplaySession> activeSessions = new HashMap<>();
+
+    // per-session 引用计数位于共享基类 RefCountedDisplayRegistry：
+    // displayId → (sessionId → refcount)。仅当所有会话的计数归零才销毁显示器。
+    // 用 per-session 计数（而非 Set）才能正确处理"同一会话既创建又串流"：
+    // 创建者引用与串流者引用独立计数，停止串流（一次 release）不会销毁仍被
+    // 创建者引用的显示器。
+
+    public VirtualDisplayRegistry() {
+    }
+
+    public VirtualDisplay getVirtualDisplay(int displayId) {
+        synchronized (lock) {
+            VirtualDisplaySession session = activeSessions.get(displayId);
+            return session != null ? session.getVirtualDisplay() : null;
+        }
+    }
+
+    public VirtualDisplaySession getSession(int displayId) {
+        synchronized (lock) {
+            return activeSessions.get(displayId);
+        }
+    }
+
+    public boolean hasDisplay(int displayId) {
+        synchronized (lock) {
+            return activeSessions.containsKey(displayId);
+        }
+    }
+
+    public int createVirtualDisplay(String name, int width, int height, int dpi, int flags) {
+        return createVirtualDisplay(name, width, height, dpi, flags, -1);
+    }
+
+    public int createVirtualDisplay(String name, int width, int height, int dpi, int flags, int mirrorDisplayId) {
+        VirtualDisplay vd = null;
+        ImageReader imageReader = null;
+        HandlerThread readerThread = null;
+        try {
+            Ln.i("VirtualDisplayRegistry: createVirtualDisplay name=" + name + ", width=" + width + ", height=" + height + ", dpi=" + dpi + ", flags=0x" + Integer.toHexString(flags) + ", mirrorDisplayId=" + mirrorDisplayId);
+
+            readerThread = new HandlerThread("VDReader-" + name);
+            readerThread.start();
+            imageReader = ImageReader.newInstance(width, height, PixelFormat.RGBA_8888, IMAGE_READER_MAX_IMAGES);
+            imageReader.setOnImageAvailableListener(reader -> {
+                try {
+                    android.media.Image img = reader.acquireLatestImage();
+                    if (img != null) {
+                        img.close();
+                    }
+                } catch (Throwable t) {
+                    Ln.w("VirtualDisplayRegistry: ImageReader error", t);
+                }
+            }, new Handler(readerThread.getLooper()));
+
+            if (mirrorDisplayId >= 0) {
+                // Use the 5-arg createVirtualDisplay to mirror a specific display.
+                // CONTRACT: the hidden 5-arg API does not take a DPI parameter —
+                // the mirrored display inherits density from the mirror SOURCE.
+                // Any requested dpi is intentionally ignored (the client UI
+                // enforces dpi>0, so callers must not depend on it under mirror).
+                // This is expected behaviour, not an error — hence info-level.
+                if (dpi > 0) {
+                    Ln.i("VirtualDisplayRegistry: mirroring displayId=" + mirrorDisplayId
+                            + " — requested DPI=" + dpi + " is ignored (inherits source density)");
+                }
+                vd = ServiceManager.getDisplayManager()
+                        .createVirtualDisplay(name, width, height, mirrorDisplayId, imageReader.getSurface());
+            } else {
+                vd = ServiceManager.getDisplayManager()
+                        .createNewVirtualDisplay(name, width, height, dpi, imageReader.getSurface(), flags);
+            }
+            int displayId = vd.getDisplay().getDisplayId();
+
+            // No requestDisplayPower() here: this daemon-managed VD is private and
+            // non-mirrored, so the system assigns it DisplayDeviceInfo.FLAG_NEVER_BLANK
+            // (VirtualDisplayAdapter) — it is never blanked by the power manager.
+            // A redundant requestDisplayPower() (only present on API 36+) is dead code
+            // and would also be a no-op security/version-wise. See DisplayManager docs.
+            VirtualDisplaySession session = new VirtualDisplaySession(displayId, name, vd, imageReader, readerThread, mirrorDisplayId);
+            synchronized (lock) {
+                activeSessions.put(displayId, session);
+            }
+            Ln.i("VirtualDisplayRegistry: created virtual display id=" + displayId + " (" + width + "x" + height + "/" + dpi + ")");
+            return displayId;
+        } catch (Exception e) {
+            Ln.e("VirtualDisplayRegistry: failed to create virtual display", e);
+            cleanupCreateFailure(vd, imageReader, readerThread);
+            return -1;
+        }
+    }
+
+    /**
+     * Best-effort rollback of the partial resources allocated during a failed
+     * {@link #createVirtualDisplay(String, int, int, int, int, int)}: a leaked
+     * VirtualDisplay, its ImageReader, and the reader HandlerThread. Each step
+     * is independent and swallowed — this must never mask the original create
+     * exception.
+     */
+    private static void cleanupCreateFailure(VirtualDisplay vd, ImageReader imageReader, HandlerThread readerThread) {
+        if (vd != null) {
+            try {
+                vd.release();
+            } catch (Exception releaseEx) {
+                Ln.w("VirtualDisplayRegistry: failed to release leaked virtual display", releaseEx);
+            }
+        }
+        if (imageReader != null) {
+            try {
+                imageReader.close();
+            } catch (Exception ignore) {
+                Ln.d("VirtualDisplayRegistry: failed to close ImageReader during create failure cleanup: " + ignore.getMessage());
+            }
+        }
+        if (readerThread != null) {
+            readerThread.quitSafely();
+        }
+    }
+
+    public boolean releaseVirtualDisplay(int displayId) {
+        return releaseVirtualDisplay(displayId, true);
+    }
+
+    /**
+     * 释放虚拟显示器。
+     *
+     * @param displayId               要销毁的显示器 id
+     * @param moveTasksToDefaultDisplay 销毁前是否将显示器上的任务移回主屏。
+     *                                 true=前台移回（保留应用在 recents）；
+     *                                 false=不处理，完全交给系统（应用通常会被系统直接关闭/移除）。
+     */
+    public boolean releaseVirtualDisplay(int displayId, boolean moveTasksToDefaultDisplay) {
+        VirtualDisplaySession session;
+        synchronized (lock) {
+            session = activeSessions.remove(displayId);
+            clearDisplay(displayId); // also clear users (force-destroy path)
+        }
+
+        if (session != null) {
+            return actuallyDestroy(displayId, session, moveTasksToDefaultDisplay);
+        }
+        Ln.w("VirtualDisplayRegistry: display id=" + displayId + " not found in activeSessions, performing best-effort release of orphan display");
+        return DisplayCompat.bestEffortReleaseOrphan(displayId);
+    }
+
+    /**
+     * Actually tear down a virtual display: thaw rotation, optionally migrate
+     * tasks back to the default display, close the session (VirtualDisplay + ImageReader).
+     * Called outside {@code activeDisplaysLock} — the heavy I/O must not hold
+     * the registry lock.
+     */
+    private boolean actuallyDestroy(int displayId, VirtualDisplaySession session, boolean moveTasksToDefaultDisplay) {
+        try {
+            // Thaw (un-freeze) rotation before releasing the virtual display
+            // so any previously frozen orientation state is released back to the system.
+            try {
+                ServiceManager.getWindowManager().thawRotation(displayId);
+                Ln.i("VirtualDisplayRegistry: thawed rotation for display id=" + displayId);
+            } catch (Throwable t) {
+                Ln.w("VirtualDisplayRegistry: failed to thaw rotation for displayId=" + displayId, t);
+            }
+            if (moveTasksToDefaultDisplay) {
+                DisplayCompat.moveTasksToDefaultDisplay(displayId);
+            } else {
+                Ln.i("VirtualDisplayRegistry: skipping task migration for display id=" + displayId
+                        + " (moveTasksToDefaultDisplay=false)");
+            }
+            session.close();
+            Ln.d("VirtualDisplayRegistry: released virtual display id=" + displayId);
+            return true;
+        } catch (Exception e) {
+            Ln.e("VirtualDisplayRegistry: failed to release virtual display id=" + displayId, e);
+            return false;
+        }
+    }
+
+    // ------------------------------------------------------------------
+    // per-session 引用计数（VD 所有权）
+    // ------------------------------------------------------------------
+
+    /**
+     * 将 session 登记为给定虚拟显示器的使用者。创建者应在
+     * {@link #createVirtualDisplay} 之后调用；接入已有 VD 的串流会话在启动视频前调用。
+     *
+     * <p>每次调用递增 per-session 引用计数：同一会话 CREATE + STREAM 会得到计数 2，
+     * 因此停止串流（一次 release）不会销毁它创建的显示器——这是重绑的关键：会话可以
+     * 关闭并重新打开视频 socket 而不销毁自己创建的显示器。
+     */
+    public void acquire(int displayId, int sessionId) {
+        synchronized (lock) {
+            super.acquireRef(displayId, sessionId);
+            Ln.d("VirtualDisplayRegistry: acquire display id=" + displayId + " for session " + sessionId
+                    + " (total users: " + userSessionCount(displayId) + ")");
+        }
+    }
+
+    /**
+     * Release a session's reference to a virtual display. If this was the last
+     * user across ALL sessions, the display is actually destroyed.
+     *
+     * @return true if the display was destroyed, false if it still has users
+     */
+    public boolean release(int displayId, int sessionId) {
+        VirtualDisplaySession session = null;
+        synchronized (lock) {
+            // Release one reference and detect (under the lock) whether this was the
+            // last user across ALL sessions.
+            boolean last = super.releaseRef(displayId, sessionId);
+            if (last || !hasUsers(displayId)) {
+                // No references left at all — remove the display and destroy it below.
+                // The `|| !hasUsers` clause is the defensive branch for a display that was
+                // never tracked (super.release returned false because it had no users): we
+                // still clean up an orphan entry if present.
+                session = activeSessions.remove(displayId);
+            } else {
+                // Other sessions (or this session's remaining refs) still hold the display.
+                Ln.d("VirtualDisplayRegistry: display id=" + displayId + " session " + sessionId
+                        + " released a reference (users remain: " + userSessionCount(displayId) + ")");
+            }
+        }
+
+        if (session != null) {
+            actuallyDestroy(displayId, session, true);
+            return true;
+        }
+        return false;
+    }
+
+    /**
+     * Release all virtual display references held by a session.
+     */
+    public void releaseSession(int sessionId) {
+        // Drop every reference held by the session, then destroy the displays this session was
+        // the last user of (i.e. those with no references left at all).
+        List<Integer> affected;
+        List<Integer> toDestroy = new ArrayList<>();
+        synchronized (lock) {
+            affected = super.releaseSessionRefs(sessionId);
+            for (int displayId : affected) {
+                if (!hasUsers(displayId)) {
+                    toDestroy.add(displayId);
+                }
+            }
+        }
+        // If a display was created but never 'acquired' via tracking (e.g. legacy/error path),
+        // the loop above misses it, but the standard flow always acquires.
+
+        for (int displayId : toDestroy) {
+            Ln.i("VirtualDisplayRegistry: destroying display " + displayId + " because session " + sessionId + " was the last user");
+            releaseVirtualDisplay(displayId);
+        }
+    }
+
+    /**
+     * Record {@code surface} as the session's external surface (the encoder's
+     * MediaCodec input surface) and bind it to the virtual display. While set,
+     * {@link #resizeVirtualDisplay} only resizes the display and leaves the
+     * ImageReader untouched — swapping the reader surface over the encoder's
+     * input surface would starve the encoder (black screen).
+     */
+    public void markExternalSurface(int displayId, Surface surface) {
+        VirtualDisplaySession session;
+        synchronized (lock) {
+            session = activeSessions.get(displayId);
+        }
+        if (session == null) {
+            Ln.w("VirtualDisplayRegistry: cannot mark external surface, display id=" + displayId + " not found");
+            return;
+        }
+        session.setExternalSurface(surface);
+    }
+
+    public boolean resizeVirtualDisplay(int displayId, int width, int height, int dpi) {
+        // Hold the registry lock only for snapshot/commit, never across binder
+        // calls (vd.resize / freezeRotation / ImageReader creation). Blocking
+        // binder work under the lock previously stalled getSession() on the
+        // roleExecutor and every create/release on other threads.
+        // Concurrent-release safety is preserved by re-validating the session
+        // before committing the new reader; a vd.resize racing with release()
+        // surfaces as IllegalStateException, caught below.
+        VirtualDisplaySession session;
+        synchronized (lock) {
+            session = activeSessions.get(displayId);
+        }
+        if (session == null) {
+            Ln.w("VirtualDisplayRegistry: display id=" + displayId + " not found for resize");
+            return false;
+        }
+
+        try {
+            // DPI fallback: when the caller does not specify a DPI, query the live value
+            // from DisplayInfo so the virtual display keeps consistent density metadata.
+            if (dpi <= 0) {
+                try {
+                    DisplayInfo info = ServiceManager.getDisplayManager().getDisplayInfo(displayId);
+                    if (info != null && info.getDpi() > 0) {
+                        dpi = info.getDpi();
+                    }
+                } catch (Throwable t) {
+                    Ln.w("VirtualDisplayRegistry: failed to query DPI from DisplayInfo for displayId=" + displayId, t);
+                }
+            }
+
+            VirtualDisplay vd = session.getVirtualDisplay();
+            Surface externalSurface = session.getExternalSurface();
+            ImageReader oldReader = session.getImageReader();
+            HandlerThread readerThread = session.getReaderThread();
+
+            if (externalSurface != null) {
+                // An external surface (e.g. MediaCodec input surface) is bound and is
+                // size-flexible — the ImageReader is not the active render target, so
+                // recreating it would be wasted work. Just resize the virtual display.
+                vd.resize(width, height, dpi);
+                Ln.i("VirtualDisplayRegistry: resized virtual display id=" + displayId + " to " + width + "x" + height
+                        + "/" + dpi + " (external surface, reader untouched)");
+                // Re-freeze rotation after resize to ensure orientation stays isolated.
+                try {
+                    ServiceManager.getWindowManager().freezeRotation(displayId, Surface.ROTATION_0);
+                } catch (Throwable ignore) {
+                    Ln.w("VirtualDisplayRegistry: freezeRotation failed (best-effort) for displayId=" + displayId, ignore);
+                }
+                return true;
+            }
+
+            if (oldReader == null || readerThread == null) {
+                // No reader to recreate — best-effort resize only.
+                vd.resize(width, height, dpi);
+                Ln.i("VirtualDisplayRegistry: resized virtual display id=" + displayId + " to " + width + "x" + height
+                        + "/" + dpi + " (no reader)");
+                try {
+                    ServiceManager.getWindowManager().freezeRotation(displayId, Surface.ROTATION_0);
+                } catch (Throwable ignore) {
+                    Ln.w("VirtualDisplayRegistry: freezeRotation failed (best-effort) for displayId=" + displayId, ignore);
+                }
+                return true;
+            }
+
+            // The ImageReader is the active surface. Recreate it atomically to avoid a
+            // no-surface window that would drop frames rendered during the swap.
+            //
+            // Order: create new reader -> bind new surface -> resize -> close old reader.
+            // The old surface is released only AFTER the new one is bound, so the display
+            // always has a valid render target. (The previous implementation closed the old
+            // reader before creating the new one, leaving a frame-drop window.)
+            ImageReader newReader = ImageReader.newInstance(width, height, PixelFormat.RGBA_8888, IMAGE_READER_MAX_IMAGES);
+            try {
+                newReader.setOnImageAvailableListener(reader -> {
+                    try {
+                        android.media.Image img = reader.acquireLatestImage();
+                        if (img != null) {
+                            img.close();
+                        }
+                    } catch (Throwable t) {
+                        Ln.w("VirtualDisplayRegistry: ImageReader error after resize", t);
+                    }
+                }, new Handler(readerThread.getLooper()));
+
+                vd.setSurface(newReader.getSurface());
+                vd.resize(width, height, dpi);
+                // Re-freeze rotation to keep virtual display orientation isolated
+                try {
+                    ServiceManager.getWindowManager().freezeRotation(displayId, Surface.ROTATION_0);
+                } catch (Throwable ignore) {
+                    Ln.w("VirtualDisplayRegistry: freezeRotation failed (best-effort) for displayId=" + displayId, ignore);
+                }
+            } catch (Exception e) {
+                try {
+                    newReader.close();
+                } catch (Exception ignore) {
+                    Ln.d("VirtualDisplayRegistry: failed to close newReader during resize failure cleanup: " + ignore.getMessage());
+                }
+                throw e;
+            }
+
+            // Commit: only swap the reader in if the session is still the active
+            // one; otherwise the display was released mid-resize.
+            synchronized (lock) {
+                if (activeSessions.get(displayId) != session) {
+                    try {
+                        newReader.close();
+                    } catch (Exception ignore) {
+                        Ln.d("VirtualDisplayRegistry: failed to close newReader after concurrent release: " + ignore.getMessage());
+                    }
+                    Ln.w("VirtualDisplayRegistry: display id=" + displayId
+                            + " released during resize; discarding new reader and aborting resize");
+                    return false;
+                }
+                session.setImageReader(newReader);
+            }
+            try {
+                oldReader.close();
+            } catch (Exception ignore) {
+                Ln.d("VirtualDisplayRegistry: failed to close oldReader after atomic swap: " + ignore.getMessage());
+            }
+
+            Ln.i("VirtualDisplayRegistry: resized virtual display id=" + displayId + " to " + width + "x" + height
+                    + "/" + dpi + " (reader swapped atomically)");
+            return true;
+        } catch (Exception e) {
+            Ln.e("VirtualDisplayRegistry: failed to resize virtual display id=" + displayId, e);
+            return false;
+        }
+    }
+
+    public int[] getActiveDisplayIds() {
+        int[] ids = ServiceManager.getDisplayManager().getDisplayIds();
+        return ids != null ? ids : new int[0];
+    }
+
+    /**
+     * Snapshot of the active virtual display ids with their live DisplayInfo
+     * (width/height/dpi/rotation). The ids are snapshotted under the registry
+     * lock, then each DisplayInfo is queried outside the lock to avoid holding
+     * it during reflection / dumpsys fallback inside DisplayManager.
+     *
+     * @return array of DisplayInfo, one per active virtual display; entries
+     *         whose DisplayInfo cannot be resolved are omitted
+     */
+    public DisplayInfo[] getActiveDisplayInfos() {
+        int[] ids = getActiveDisplayIds();
+
+        // Snapshot active sessions to avoid holding the lock during getDisplayInfo() calls
+        Map<Integer, VirtualDisplaySession> sessionsSnapshot;
+        synchronized (lock) {
+            sessionsSnapshot = new HashMap<>(activeSessions);
+        }
+
+        List<DisplayInfo> result = new ArrayList<>(ids.length);
+        for (int id : ids) {
+            try {
+                DisplayInfo info = ServiceManager.getDisplayManager().getDisplayInfo(id);
+                if (info != null) {
+                    int mirrorDisplayId = -1;
+                    boolean owned = false;
+                    VirtualDisplaySession session = sessionsSnapshot.get(id);
+                    if (session != null) {
+                        mirrorDisplayId = session.getMirrorDisplayId();
+                        owned = true;
+                    }
+                    DisplayInfo enrichedInfo = new DisplayInfo(
+                        info.getDisplayId(),
+                        info.getSize(),
+                        info.getRotation(),
+                        info.getLayerStack(),
+                        info.getFlags(),
+                        info.getDpi(),
+                        info.getUniqueId(),
+                        mirrorDisplayId,
+                        owned,
+                        info.getOwnerPackageName(),
+                        info.getOwnerUid()
+                    );
+                    result.add(enrichedInfo);
+                } else {
+                    Ln.w("VirtualDisplayRegistry: getDisplayInfo returned null for displayId=" + id);
+                }
+            } catch (Throwable t) {
+                Ln.w("VirtualDisplayRegistry: failed to query DisplayInfo for displayId=" + id, t);
+            }
+        }
+        return result.toArray(new DisplayInfo[0]);
+    }
+
+    public void releaseAll() {
+        int[] ids;
+        synchronized (lock) {
+            ids = new int[activeSessions.size()];
+            int i = 0;
+            for (int id : activeSessions.keySet()) {
+                ids[i++] = id;
+            }
+        }
+        for (int id : ids) {
+            releaseVirtualDisplay(id);
+        }
+        Ln.i("VirtualDisplayRegistry: all virtual displays released");
+    }
+}
