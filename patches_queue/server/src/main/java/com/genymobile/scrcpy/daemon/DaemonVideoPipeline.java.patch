+package com.genymobile.scrcpy.daemon;
+
+import com.genymobile.scrcpy.Options;
+import com.genymobile.scrcpy.control.Controller;
+import com.genymobile.scrcpy.control.PositionMapper;
+import com.genymobile.scrcpy.daemon.display.DisplaySurfaceBroker;
+import com.genymobile.scrcpy.video.FrameSink;
+import com.genymobile.scrcpy.video.ScreenCapture;
+import com.genymobile.scrcpy.video.SurfaceCapture;
+import com.genymobile.scrcpy.video.SurfaceEncoder;
+import com.genymobile.scrcpy.video.VirtualDisplayListener;
+
+/**
+ * 共享 capture+encode 管线的工厂：为
+ * {@link com.genymobile.scrcpy.daemon.video.FrameBroadcaster} 构建
+ * {@link ScreenCapture} → {@link SurfaceEncoder} 组合。
+ *
+ * <p>本类是 daemon 中唯一集中引用上游 {@code video/ScreenCapture} 与
+ * {@code video/SurfaceEncoder} 的地方，把上游耦合收敛到一处。编码器写入
+ * {@link FrameSink}（即 broadcaster），由后者向 N 个订阅者分发；每个订阅者各自
+ * 持有包装自己 socket FD 的 {@code Streamer}。
+ */
+public final class DaemonVideoPipeline {
+
+    /**
+     * 可变的 VirtualDisplayListener 中转。broadcaster 可能在控制 socket 之前创建
+     * （video-first 顺序），此时尚无 Controller。代理缓存最近一次
+     * (virtualDisplayId, PositionMapper) 通知，并在绑定 delegate 时重投，使迟绑定的
+     * Controller 仍能收到显示数据。
+     */
+    public static final class VdListenerProxy implements VirtualDisplayListener {
+        private volatile VirtualDisplayListener delegate = (virtualDisplayId, positionMapper) -> { };
+        private int virtualDisplayId = -1;
+        private PositionMapper positionMapper;
+
+        public synchronized void setDelegate(VirtualDisplayListener newDelegate) {
+            delegate = newDelegate;
+            if (newDelegate != null && virtualDisplayId != -1) {
+                newDelegate.onNewVirtualDisplay(virtualDisplayId, positionMapper);
+            }
+        }
+
+        @Override
+        public synchronized void onNewVirtualDisplay(int virtualDisplayId, PositionMapper positionMapper) {
+            this.virtualDisplayId = virtualDisplayId;
+            this.positionMapper = positionMapper;
+            delegate.onNewVirtualDisplay(virtualDisplayId, positionMapper);
+        }
+    }
+
+    /** Immutable holder for the constructed pipeline components. */
+    public static final class Built {
+        private final SurfaceCapture surfaceCapture;
+        private final SurfaceEncoder surfaceEncoder;
+        private final VdListenerProxy vdListenerProxy;
+
+        Built(SurfaceCapture surfaceCapture, SurfaceEncoder surfaceEncoder, VdListenerProxy vdListenerProxy) {
+            this.surfaceCapture = surfaceCapture;
+            this.surfaceEncoder = surfaceEncoder;
+            this.vdListenerProxy = vdListenerProxy;
+        }
+
+        public SurfaceCapture getSurfaceCapture() {
+            return surfaceCapture;
+        }
+
+        public SurfaceEncoder getSurfaceEncoder() {
+            return surfaceEncoder;
+        }
+
+        /** Non-null only when no controller existed at build time (video-first ordering). */
+        public VdListenerProxy getVdListenerProxy() {
+            return vdListenerProxy;
+        }
+    }
+
+    private DaemonVideoPipeline() {
+    }
+
+    /**
+     * 为 broadcaster 构建共享 capture+encode 管线：改写 base args 的 {@code display_id} 并
+     * 重新解析 options，然后接线 {@link ScreenCapture}（注入 daemon 的
+     * {@link DisplaySurfaceBroker} 作为 {@code ExternalDisplayProvider}）→
+     * {@link SurfaceEncoder} 写入 {@code sink}。
+     *
+     * <p>刻意不调用 {@code controller.setSurfaceCapture()}：capture 为所有订阅者共享，
+     * 不能被任一会话的 controller 改写；resize 走 {@code FrameBroadcasterRegistry}。
+     *
+     * @param displayId     目标显示器 id
+     * @param baseArgs      已清洗的 scrcpy 参数（display_id 会被改写）
+     * @param options       基础会话 options（codec / stream-meta 标志来自这里）
+     * @param surfaceBroker daemon 管理的 external display provider
+     * @param controller    首个订阅者的 controller（作为 {@code VirtualDisplayListener}），
+     *                      可为 {@code null}
+     * @param sink          接收编码包的 broadcaster（FrameSink）
+     * @return 引用新建管线的 {@link Built}
+     * @throws Exception option 解析或管线构建失败（由调用方处理）
+     */
+    public static Built buildBroadcaster(int displayId, String[] baseArgs, Options options,
+                                         DisplaySurfaceBroker surfaceBroker,
+                                         Controller controller, FrameSink sink) throws Exception {
+        String[] modifiedArgs = DaemonArgs.changeDisplayId(baseArgs, displayId);
+        Options captureOptions = Options.parse(modifiedArgs);
+
+        // ScreenCapture 需要 VirtualDisplayListener；controller 尚未接线时（控制 socket 未
+        // 绑定）用代理兜底，使 capture 仍可构造，并支持后续 setDelegate() 迟绑定。
+        VirtualDisplayListener listener;
+        if (controller != null) {
+            listener = controller;
+        } else {
+            listener = new VdListenerProxy();
+        }
+        ScreenCapture screen = new ScreenCapture(listener, captureOptions);
+        screen.setExternalDisplayProvider(surfaceBroker);
+        SurfaceCapture surfaceCapture = screen;
+
+        SurfaceEncoder surfaceEncoder = new SurfaceEncoder(surfaceCapture, sink, captureOptions);
+
+        return new Built(surfaceCapture, surfaceEncoder, listener instanceof VdListenerProxy ? (VdListenerProxy) listener : null);
+    }
+}
