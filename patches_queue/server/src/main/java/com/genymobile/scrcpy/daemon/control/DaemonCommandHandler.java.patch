+package com.genymobile.scrcpy.daemon.control;
+
+import com.genymobile.scrcpy.control.ControlMessage;
+import com.genymobile.scrcpy.control.ControlMessageExtension;
+import com.genymobile.scrcpy.control.DeviceMessage;
+import com.genymobile.scrcpy.control.DeviceMessageSender;
+import com.genymobile.scrcpy.daemon.DaemonExitCoordinator;
+import com.genymobile.scrcpy.daemon.SessionConfigurator;
+import com.genymobile.scrcpy.daemon.display.ActivityLauncher;
+import com.genymobile.scrcpy.daemon.display.AppLister;
+import com.genymobile.scrcpy.daemon.display.RotationController;
+import com.genymobile.scrcpy.daemon.display.VirtualDisplayRegistry;
+import com.genymobile.scrcpy.daemon.video.FrameBroadcasterRegistry;
+import com.genymobile.scrcpy.util.Ln;
+import com.genymobile.scrcpy.video.CaptureControl;
+
+import java.io.IOException;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.ThreadFactory;
+
+/**
+ * daemon 命令分发器：按 {@link ExecutionPolicy} 将命令投递到交互线程或生命周期线程执行。
+ *
+ * <p>一个实例服务一条通道（协商通道或控制通道），回复统一走构造时注入的
+ * {@link DeviceMessageSender}。
+ */
+public final class DaemonCommandHandler implements ControlMessageExtension {
+
+    /**
+     * Upper bound on how long {@code EXIT_DAEMON} waits for its OK reply to reach the socket before
+     * tearing the connection down anyway.
+     */
+    private static final long EXIT_DRAIN_TIMEOUT_MS = 500;
+
+    private static class HandlerEntry {
+        private final ExecutionPolicy policy;
+        private final CommandHandler handler;
+
+        HandlerEntry(ExecutionPolicy policy, CommandHandler handler) {
+            this.policy = policy;
+            this.handler = handler;
+        }
+    }
+
+    private final DeviceMessageSender sender;
+    private final int sessionId;
+    private final VirtualDisplayRegistry registry;
+    private final DaemonExitCoordinator exitCoordinator;
+    private final RotationController rotationController;
+    private final SessionConfigurator sessionConfigurator;
+    private final FrameBroadcasterRegistry broadcasterRegistry;
+
+    // interactiveExecutor / lifecycleExecutor 的线程必须先调用 Looper.prepare() 并保持
+    // Looper 存活：它们执行的代码路径会触发依赖 Handler 的惰性静态初始化
+    // （Workarounds.getSystemContext() → ActivityThread → Handler()），在未 prepare 的
+    // 线程上会抛 "Can't create handler inside thread that has not called Looper.prepare()"。
+    private static final class LooperThreadFactory implements ThreadFactory {
+        private final String namePrefix;
+        private int counter = 0;
+
+        LooperThreadFactory(String namePrefix) {
+            this.namePrefix = namePrefix;
+        }
+
+        @Override
+        public synchronized Thread newThread(Runnable r) {
+            final int id = ++counter;
+            Thread t = new Thread(() -> {
+                android.os.Looper.prepare();
+                r.run();
+            }, namePrefix + "-" + id);
+            t.setDaemon(true);
+            return t;
+        }
+    }
+
+    private final ExecutorService interactiveExecutor = Executors.newSingleThreadExecutor(new LooperThreadFactory("daemon-cmd-interactive"));
+    private final ExecutorService lifecycleExecutor = Executors.newFixedThreadPool(4, new LooperThreadFactory("daemon-cmd-lifecycle"));
+    // 独立的单线程关闭执行器：刻意不在 close() 中关闭，使 EXIT_DAEMON 任务即便在
+    // 其他执行器停止后仍能跑完（任务体自身会调用 close()）。
+    private final ExecutorService exitExecutor = Executors.newSingleThreadExecutor(new LooperThreadFactory("daemon-cmd-exit"));
+    private final Map<Integer, HandlerEntry> handlers = new HashMap<>();
+
+    public DaemonCommandHandler(DeviceMessageSender sender,
+                                VirtualDisplayRegistry registry, DaemonExitCoordinator exitCoordinator,
+                                SessionConfigurator sessionConfigurator,
+                                FrameBroadcasterRegistry broadcasterRegistry,
+                                int sessionId) {
+        this.sender = sender;
+        this.registry = registry;
+        this.exitCoordinator = exitCoordinator;
+        this.rotationController = new RotationController(registry);
+        this.sessionConfigurator = sessionConfigurator;
+        this.broadcasterRegistry = broadcasterRegistry;
+        this.sessionId = sessionId;
+        initRegistry();
+    }
+
+    public void close() {
+        interactiveExecutor.shutdownNow();
+        lifecycleExecutor.shutdownNow();
+    }
+
+    private void register(int type, ExecutionPolicy policy, CommandHandler handler) {
+        handlers.put(type, new HandlerEntry(policy, handler));
+    }
+
+    private void initRegistry() {
+        initDisplayCommands();
+        initRotationCommands();
+        initSessionCommands();
+        initAppCommands();
+        initMiscCommands();
+    }
+
+    private void initDisplayCommands() {
+        register(DaemonMessages.TYPE_CREATE_VIRTUAL_DISPLAY, ExecutionPolicy.SLOW, (msg, sender) -> {
+            DaemonControlMessage dto = DaemonMessages.payload(msg);
+            int newDisplayId = registry.createVirtualDisplay(
+                    dto.getText(), dto.getWidth(), dto.getHeight(), dto.getDpi(), dto.getFlags(), dto.getDisplayId());
+            if (newDisplayId == -1) {
+                throw new RuntimeException("FAILED");
+            }
+            // 默认持久化：daemon 自身(-1)与本会话各持一个引用。
+            registry.acquire(newDisplayId, VirtualDisplayRegistry.PERSISTENT_SESSION_ID);
+            registry.acquire(newDisplayId, sessionId);
+            sendSuccessResponse(msg, newDisplayId, "OK");
+        });
+
+        register(DaemonMessages.TYPE_RELEASE_VIRTUAL_DISPLAY, ExecutionPolicy.SLOW, (msg, sender) -> {
+            DaemonControlMessage dto = DaemonMessages.payload(msg);
+            // 手动移除：无视会话引用强制销毁显示器，并清掉 daemon 持有的持久引用。
+            // 这是唯一会销毁显示器的路径（创建与销毁完全由用户驱动）。
+            boolean moveTasksToDefaultDisplay = dto.getFlags() == DaemonControlMessage.RELEASE_MOVE_TASKS_TO_DEFAULT;
+            boolean destroyed = registry.releaseVirtualDisplay(dto.getDisplayId(), moveTasksToDefaultDisplay);
+            if (destroyed) {
+                // 显示器已销毁：仍挂在它上面的共享 broadcaster/encoder 必须一并拆除，
+                // 否则 encoder 会继续从已失效的 surface 渲染（幽灵管线）。
+                broadcasterRegistry.releaseDisplay(dto.getDisplayId());
+            }
+            sendSuccessResponse(msg, dto.getDisplayId(), destroyed ? "DESTROYED" : "FAILED");
+        });
+
+        register(DaemonMessages.TYPE_RESIZE_VIRTUAL_DISPLAY, ExecutionPolicy.SLOW, (msg, sender) -> {
+            DaemonControlMessage dto = DaemonMessages.payload(msg);
+            int displayId = dto.getDisplayId();
+            boolean ok = registry.resizeVirtualDisplay(
+                    displayId, dto.getWidth(), dto.getHeight(), dto.getDpi());
+            if (!ok) {
+                throw new RuntimeException("FAILED");
+            }
+            // 踢一下共享 broadcaster 的 encoder，使其按新尺寸重建；所有订阅者会从
+            // encoder 的重置路径收到新的 session meta。
+            Ln.i("DaemonCommandHandler: resize displayId=" + displayId
+                    + " — requesting shared broadcaster reset for new size "
+                    + dto.getWidth() + "x" + dto.getHeight());
+            broadcasterRegistry.kick(displayId,
+                    CaptureControl.RESET_REASON_CLIENT_RESIZED
+                            | CaptureControl.RESET_REASON_DISPLAY_PROPERTIES_CHANGED);
+            sendSuccessResponse(msg, displayId, "OK");
+        });
+
+        register(DaemonMessages.TYPE_GET_ACTIVE_DISPLAY_IDS, ExecutionPolicy.FAST, (msg, sender) -> {
+            int[] ids = registry.getActiveDisplayIds();
+            if (sender != null) {
+                DeviceMessage response = DaemonMessages.createActiveDisplaysResponse(DaemonMessages.payload(msg).getSequence(), ids);
+                sender.send(response);
+            }
+        });
+
+        register(DaemonMessages.TYPE_GET_ACTIVE_DISPLAY_INFOS, ExecutionPolicy.FAST, (msg, sender) -> {
+            com.genymobile.scrcpy.display.DisplayInfo[] infos = registry.getActiveDisplayInfos();
+            if (sender != null) {
+                DeviceMessage response = DaemonMessages.createActiveDisplayInfosResponse(DaemonMessages.payload(msg).getSequence(), infos);
+                sender.send(response);
+            }
+        });
+    }
+
+    private void initRotationCommands() {
+        register(DaemonMessages.TYPE_GET_ROTATION, ExecutionPolicy.FAST, (msg, sender) -> {
+            DaemonControlMessage dto = DaemonMessages.payload(msg);
+            int rotation = rotationController.getRotation(dto.getDisplayId());
+            sendSuccessResponse(msg, dto.getDisplayId(), String.valueOf(rotation));
+        });
+
+        register(DaemonMessages.TYPE_FREEZE_ROTATION, ExecutionPolicy.FAST, (msg, sender) -> {
+            DaemonControlMessage dto = DaemonMessages.payload(msg);
+            rotationController.freeze(dto.getDisplayId(), dto.getRotation());
+            sendSuccessResponse(msg, dto.getDisplayId(), "OK");
+        });
+
+        register(DaemonMessages.TYPE_THAW_ROTATION, ExecutionPolicy.FAST, (msg, sender) -> {
+            DaemonControlMessage dto = DaemonMessages.payload(msg);
+            rotationController.thaw(dto.getDisplayId());
+            sendSuccessResponse(msg, dto.getDisplayId(), "OK");
+        });
+
+        register(DaemonMessages.TYPE_IS_ROTATION_FROZEN, ExecutionPolicy.FAST, (msg, sender) -> {
+            DaemonControlMessage dto = DaemonMessages.payload(msg);
+            int frozen = rotationController.isFrozen(dto.getDisplayId());
+            sendSuccessResponse(msg, dto.getDisplayId(), String.valueOf(frozen));
+        });
+    }
+
+    private void initSessionCommands() {
+        register(DaemonMessages.TYPE_CONFIGURE_SESSION, ExecutionPolicy.FAST, (msg, sender) -> {
+            if (sessionConfigurator == null) {
+                throw new RuntimeException("CONFIGURE_SESSION is only available on the negotiation channel");
+            }
+            DaemonControlMessage dto = DaemonMessages.payload(msg);
+            sessionConfigurator.configure(dto.getOptionsKv(), dto.getRolesMask(), dto.getRolesEntries());
+            sendSuccessResponse(msg, -1, "OK");
+        });
+    }
+
+    private void initAppCommands() {
+        register(DaemonMessages.TYPE_START_ACTIVITY, ExecutionPolicy.SLOW, (msg, sender) -> {
+            DaemonControlMessage dto = DaemonMessages.payload(msg);
+            if (ActivityLauncher.startActivity(dto.getText(), dto.getDisplayId()) < 0) {
+                throw new RuntimeException("FAILED");
+            }
+            sendSuccessResponse(msg, dto.getDisplayId(), "OK");
+        });
+
+        register(DaemonMessages.TYPE_LAUNCH_HOME, ExecutionPolicy.SLOW, (msg, sender) -> {
+            DaemonControlMessage dto = DaemonMessages.payload(msg);
+            if (ActivityLauncher.launchHome(dto.getDisplayId()) < 0) {
+                throw new RuntimeException("FAILED");
+            }
+            sendSuccessResponse(msg, dto.getDisplayId(), "OK");
+        });
+
+        register(DaemonMessages.TYPE_LIST_APPS, ExecutionPolicy.SLOW, (msg, sender) -> {
+            java.util.List<com.genymobile.scrcpy.model.DeviceApp> apps = AppLister.listInstalledApps();
+            if (sender != null) {
+                DeviceMessage response = DaemonMessages.createAppsListResponse(DaemonMessages.payload(msg).getSequence(), apps);
+                sender.send(response);
+            }
+        });
+    }
+
+    private void initMiscCommands() {
+        register(DaemonMessages.TYPE_EXIT_DAEMON, ExecutionPolicy.FAST, (msg, sender) -> {
+            Ln.i("handleExitDaemon: Quit request received, replying OK and shutting down...");
+            sendSuccessResponse(msg, -1, "OK");
+
+            // 在专用 exitExecutor（不被 close() 关闭）上执行，使 daemon 一定能走到
+            // requestExit() + close()，即便任务体自身调用了 close()。
+            exitExecutor.submit(() -> {
+                // 先等 OK 回包真正写入 socket 再拆连接：固定 sleep 是竞态（慢设备或大队列
+                // 下回包会随连接一起被丢弃），这里改为等待发送队列排空。
+                if (sender != null) {
+                    try {
+                        if (!sender.awaitDrained(EXIT_DRAIN_TIMEOUT_MS)) {
+                            Ln.w("handleExitDaemon: OK reply not flushed within " + EXIT_DRAIN_TIMEOUT_MS
+                                    + "ms; exiting anyway");
+                        }
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                        Ln.w("handleExitDaemon: interrupted while waiting for the reply to flush; exiting anyway");
+                    }
+                }
+                exitCoordinator.requestExit();
+                close();
+                // 自终止，避免在未能退出的 daemon 上重复 EXIT_DAEMON 时线程堆积。
+                exitExecutor.shutdown();
+            });
+        });
+
+        register(DaemonMessages.TYPE_PING, ExecutionPolicy.FAST, (msg, sender) -> sendSuccessResponse(msg, -1, "PONG"));
+    }
+
+    @Override
+    public boolean handle(ControlMessage msg) throws IOException {
+        HandlerEntry entry = handlers.get(msg.getType());
+        if (entry == null) {
+            return false;
+        }
+
+        Runnable task = () -> {
+            try {
+                entry.handler.handle(msg, sender);
+            } catch (Throwable t) {
+                Ln.e("Execution of command type=" + msg.getType() + " failed", t);
+                sendErrorResponse(msg, t);
+            }
+        };
+
+        // submit() 是执行器状态的唯一判据：close() 可能在检查与提交之间 shutdownNow()，
+        // 让 RejectedExecutionException 逃逸会终止控制接收线程。
+        try {
+            if (entry.policy == ExecutionPolicy.FAST) {
+                interactiveExecutor.submit(task);
+            } else {
+                lifecycleExecutor.submit(task);
+            }
+        } catch (RejectedExecutionException e) {
+            Ln.w("DaemonCommandHandler: executor rejected message type=" + msg.getType() + " (shutting down?)");
+            sendErrorResponse(msg, new IllegalStateException("daemon is shutting down"));
+        }
+        return true;
+    }
+
+    private void sendSuccessResponse(ControlMessage msg, int extraData, String text) {
+        if (sender == null) {
+            return;
+        }
+        try {
+            DeviceMessage response = DaemonMessages.createGenericResponse(DaemonMessages.payload(msg).getSequence(), 0, extraData, text);
+            sender.send(response);
+        } catch (Exception e) {
+            Ln.e("Failed to send response", e);
+        }
+    }
+
+    private void sendErrorResponse(ControlMessage msg, Throwable t) {
+        if (sender == null) {
+            return;
+        }
+        try {
+            // 完整堆栈已在分发处记录（Ln.e），回给客户端的只保留简短原因：
+            // 异常简单类名 +（可选）消息，避免泄露内部类路径。
+            String reason = t.getClass().getSimpleName();
+            if (t.getMessage() != null && !t.getMessage().isEmpty()) {
+                reason += ": " + t.getMessage();
+            }
+            DeviceMessage response = DaemonMessages.createGenericResponse(DaemonMessages.payload(msg).getSequence(), -1, -1, reason);
+            sender.send(response);
+        } catch (Exception e) {
+            Ln.e("Failed to send error response", e);
+        }
+    }
+}
