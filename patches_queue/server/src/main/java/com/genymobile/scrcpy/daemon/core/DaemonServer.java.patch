+package com.genymobile.scrcpy.daemon.core;
+
+import android.os.Looper;
+
+import com.genymobile.scrcpy.Options;
+import com.genymobile.scrcpy.daemon.display.DisplaySurfaceBroker;
+import com.genymobile.scrcpy.daemon.display.VirtualDisplayRegistry;
+import com.genymobile.scrcpy.daemon.net.InstanceMutex;
+import com.genymobile.scrcpy.daemon.net.TcpDesktopConnection;
+import com.genymobile.scrcpy.daemon.net.TcpServerSocketListener;
+import com.genymobile.scrcpy.daemon.video.FrameBroadcasterRegistry;
+import com.genymobile.scrcpy.util.Ln;
+
+import java.io.IOException;
+import java.net.Socket;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+
+public final class DaemonServer {
+
+    private static final int MAX_SESSIONS = 16;
+    // 鉴权黑名单上限：不设上限时，恶意本地对端可用伪造源 IP 无限增长该集合
+    // （多用户设备上每个伪造 IP 一条）。集合满时降级为告警放行（避免永久 DoS）。
+    private static final int MAX_BLACKLISTED_IPS = 256;
+    // 关闭时等待工作线程退出的上限；超时则 shutdownNow() 并告警。
+    private static final long WORKER_TERMINATION_TIMEOUT_MS = 3000;
+
+    private final Options options;
+    private final DaemonOptions daemonOptions;
+    private final String[] baseArgs;
+
+    private final Map<Integer, ClientSession> sessions = new ConcurrentHashMap<>();
+    private final AtomicInteger nextSessionId = new AtomicInteger(1);
+    private final AtomicBoolean running = new AtomicBoolean(true);
+    /** run() 等待退出用的监视器；与 running 的原子值语义分离，避免一物两用。 */
+    private final Object runLock = new Object();
+
+    private final VirtualDisplayRegistry registry;
+    private final DisplaySurfaceBroker surfaceBroker;
+    private final DaemonExitCoordinator exitCoordinator;
+    private final FrameBroadcasterRegistry broadcasterRegistry;
+
+    private final String secretToken;
+    private final Set<String> blacklistedIps = ConcurrentHashMap.newKeySet();
+
+    private ExecutorService acceptExecutor;
+    private ExecutorService clientExecutor;
+    private ExecutorService roleExecutor;
+
+    public DaemonServer(Options options, DaemonOptions daemonOptions, String[] baseArgs) {
+        this.options = options;
+        this.daemonOptions = daemonOptions;
+        this.baseArgs = baseArgs;
+        this.registry = new VirtualDisplayRegistry();
+        this.surfaceBroker = new DisplaySurfaceBroker(registry);
+        this.exitCoordinator = new DaemonExitCoordinator(this);
+        this.broadcasterRegistry = new FrameBroadcasterRegistry(surfaceBroker);
+
+        String token = daemonOptions.getSecretToken();
+        if ("auto".equalsIgnoreCase(token)) {
+            // 128-bit 随机 token（32 个 hex 字符）。
+            token = UUID.randomUUID().toString().replace("-", "");
+            // token 不得出现在 INFO 级：logcat 全局可读，凭据会泄露给设备上任意应用。
+            Ln.i("AUTOMATIC DAEMON SECRET TOKEN GENERATED (visible at verbose log level)");
+            Ln.v("daemon secret token: " + token);
+        }
+        this.secretToken = token;
+    }
+
+    public void run() throws IOException {
+        Ln.i("Daemon: starting on port " + daemonOptions.getPort() + ", bind=" + daemonOptions.getBindAddress());
+
+        try {
+            // 先取与端口无关的单实例锁再绑定：即便换了端口，第二个 daemon 也必须在这里失败。
+            InstanceMutex.acquire(InstanceMutex.DEFAULT_NAME);
+            TcpServerSocketListener.initServerSocket(daemonOptions.getPort(), daemonOptions.getBindAddress());
+
+            acceptExecutor = Executors.newSingleThreadExecutor(r -> {
+                Thread t = new Thread(r, "daemon-accept");
+                t.setDaemon(true);
+                return t;
+            });
+            clientExecutor = Executors.newFixedThreadPool(MAX_SESSIONS, r -> {
+                Thread t = new Thread(() -> {
+                    Looper.prepare();
+                    r.run();
+                }, "daemon-client");
+                t.setDaemon(true);
+                return t;
+            });
+            // role socket（ROLE_CONTROL/VIDEO/AUDIO）从单线程 accept 线程上分派出去，
+            // 使阻塞的 role 处理器无法拖住其它显示器的 socket 接受。
+            roleExecutor = Executors.newFixedThreadPool(MAX_SESSIONS, r -> {
+                Thread t = new Thread(r, "daemon-role");
+                t.setDaemon(true);
+                return t;
+            });
+
+            acceptExecutor.submit(this::acceptLoop);
+
+            // 带超时的等待：即使 notify 丢失（如 accept 线程异常死亡），也能周期性地
+            // 复查 running 并退出，避免 run() 永久阻塞。
+            try {
+                synchronized (runLock) {
+                    while (running.get()) {
+                        runLock.wait(1000);
+                    }
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            }
+        } finally {
+            shutdown();
+        }
+    }
+
+    private void acceptLoop() {
+        Ln.i("Daemon: accept loop started");
+        while (running.get()) {
+            try {
+                Socket socket = TcpServerSocketListener.acceptNextSocket();
+                String ip = socket.getInetAddress().getHostAddress();
+                if (blacklistedIps.contains(ip)) {
+                    Ln.w("Connection rejected from blacklisted IP: " + ip);
+                    TcpDesktopConnection.closeQuietly(socket);
+                    continue;
+                }
+
+                if (sessions.size() >= MAX_SESSIONS) {
+                    Ln.w("Connection rejected: maximum sessions reached (" + MAX_SESSIONS + ")");
+                    TcpDesktopConnection.closeQuietly(socket);
+                    continue;
+                }
+
+                int role;
+                try {
+                    role = TcpDesktopConnection.readSocketRole(socket);
+                } catch (IOException e) {
+                    // SocketTimeoutException（握手超时）也走这里。
+                    Ln.w("Failed to read socket role from " + ip + ": " + e.getClass().getSimpleName()
+                            + (e.getMessage() != null ? ": " + e.getMessage() : ""));
+                    TcpDesktopConnection.closeQuietly(socket);
+                    continue;
+                }
+
+                switch (role) {
+                    case TcpDesktopConnection.ROLE_NEGOTIATION:
+                        handleNegotiationSocket(socket);
+                        break;
+                    case TcpDesktopConnection.ROLE_CONTROL:
+                    case TcpDesktopConnection.ROLE_VIDEO:
+                    case TcpDesktopConnection.ROLE_AUDIO:
+                        // 从 accept 线程分派出去：协商保持内联（只创建会话），但 role
+                        // 处理器可能阻塞，绝不能拖住 accept 循环。
+                        try {
+                            roleExecutor.execute(() -> handleRoleSocket(role, socket));
+                        } catch (RejectedExecutionException e) {
+                            Ln.w("Role socket rejected (roleExecutor shut down?)");
+                            TcpDesktopConnection.closeQuietly(socket);
+                        }
+                        break;
+                    default:
+                        Ln.w("Unknown socket role: " + role);
+                        TcpDesktopConnection.closeQuietly(socket);
+                }
+            } catch (IOException e) {
+                if (running.get()) {
+                    Ln.w("Accept loop error: " + e.getMessage());
+                }
+            } catch (RuntimeException e) {
+                // accept 线程绝不能因 RuntimeException 退出：那会让 daemon 对新连接
+                // 彻底失聪，而旧会话仍在运行。
+                if (running.get()) {
+                    Ln.e("Accept loop unexpected error", e);
+                }
+            }
+        }
+        Ln.i("Daemon: accept loop exited");
+    }
+
+    private void blacklistIp(String ip) {
+        if (blacklistedIps.size() >= MAX_BLACKLISTED_IPS) {
+            Ln.w("Blacklist full (" + MAX_BLACKLISTED_IPS + "), refusing to blacklist further IPs");
+            return;
+        }
+        blacklistedIps.add(ip);
+    }
+
+    private void handleNegotiationSocket(Socket socket) {
+        // 在 [1, Integer.MAX_VALUE] 内原子分配 session id，溢出时回绕到 1。
+        // getAndUpdate 是原子的；回绕后需避开仍在活动中的 id。
+        int sessionId;
+        do {
+            sessionId = nextSessionId.getAndUpdate(prev -> prev >= Integer.MAX_VALUE ? 1 : prev + 1);
+        } while (sessions.containsKey(sessionId));
+
+        try {
+            TcpDesktopConnection.writeSessionId(socket, sessionId);
+        } catch (IOException e) {
+            Ln.w("Failed to write sessionId: " + e.getMessage());
+            TcpDesktopConnection.closeQuietly(socket);
+            return;
+        }
+
+        if (secretToken != null) {
+            String ip = socket.getInetAddress().getHostAddress();
+            try {
+                if (!TcpDesktopConnection.authenticate(socket, secretToken)) {
+                    blacklistIp(ip);
+                    Ln.w("Authentication failed for IP: " + ip + ". IP blacklisted.");
+                    TcpDesktopConnection.closeQuietly(socket);
+                    return;
+                }
+            } catch (Exception e) {
+                blacklistIp(ip);
+                Ln.w("Authentication error for IP: " + ip + ". IP blacklisted. Error: " + e.getMessage());
+                TcpDesktopConnection.closeQuietly(socket);
+                return;
+            }
+        }
+
+        ClientSession session;
+        try {
+            // 协商握手结束，进入长驻数据阶段。
+            TcpDesktopConnection.clearSoTimeout(socket);
+            session = new ClientSession(socket, sessionId, options, baseArgs, registry, surfaceBroker, exitCoordinator, this, broadcasterRegistry);
+        } catch (IOException e) {
+            Ln.w("Failed to create client session: " + e.getMessage());
+            TcpDesktopConnection.closeQuietly(socket);
+            return;
+        }
+
+        sessions.put(sessionId, session);
+        Ln.i(DaemonLog.tag(sessionId) + ": new negotiation session from " + socket.getRemoteSocketAddress());
+
+        try {
+            clientExecutor.submit(session);
+        } catch (RejectedExecutionException e) {
+            // 执行器在 accept 与 submit 之间被关闭（daemon 正在退出）：移除表项并拆掉会话，
+            // 避免 socket 泄漏。
+            Ln.w(DaemonLog.tag(sessionId) + ": session rejected (executor shut down?), cleaning up");
+            sessions.remove(sessionId);
+            session.shutdown();
+        }
+    }
+
+    private void handleRoleSocket(int role, Socket socket) {
+        try {
+            int sessionId = TcpDesktopConnection.readSessionId(socket);
+            int displayId = TcpDesktopConnection.readDisplayId(socket);
+            ClientSession session = sessions.get(sessionId);
+            if (session == null) {
+                Ln.w(DaemonLog.tag(sessionId) + ": role socket " + role + " for unknown session");
+                TcpDesktopConnection.closeQuietly(socket);
+                return;
+            }
+            // role 握手结束，进入长驻数据阶段。
+            TcpDesktopConnection.clearSoTimeout(socket);
+            switch (role) {
+                case TcpDesktopConnection.ROLE_CONTROL:
+                    session.onControlSocket(displayId, socket);
+                    break;
+                case TcpDesktopConnection.ROLE_VIDEO:
+                    session.onVideoSocket(displayId, socket);
+                    break;
+                case TcpDesktopConnection.ROLE_AUDIO:
+                    session.onAudioSocket(displayId, socket);
+                    break;
+                default:
+                    Ln.w("Unexpected role in handleRoleSocket: " + role);
+                    TcpDesktopConnection.closeQuietly(socket);
+                    break;
+            }
+        } catch (IOException e) {
+            Ln.w("Failed to handle role " + role + " socket: " + e.getMessage());
+            TcpDesktopConnection.closeQuietly(socket);
+        }
+    }
+
+    private void shutdown() {
+        Ln.i("Daemon: shutting down, " + sessions.size() + " active sessions");
+
+        for (ClientSession session : sessions.values()) {
+            session.shutdown();
+        }
+        sessions.clear();
+
+        // 先停 encoder 再销毁虚拟显示器：运行中的 encoder 捕获持有一份 VD surface 引用。
+        if (broadcasterRegistry != null) {
+            broadcasterRegistry.releaseAll();
+        }
+        if (registry != null) {
+            registry.releaseAll();
+        }
+
+        List<ExecutorService> executors = new ArrayList<>(3);
+        List<String> names = new ArrayList<>(3);
+        if (acceptExecutor != null) {
+            executors.add(acceptExecutor);
+            names.add("accept");
+        }
+        if (clientExecutor != null) {
+            executors.add(clientExecutor);
+            names.add("client");
+        }
+        if (roleExecutor != null) {
+            executors.add(roleExecutor);
+            names.add("role");
+        }
+        for (ExecutorService executor : executors) {
+            executor.shutdown();
+        }
+        // 等待工作线程真正退出后再释放监听端口与单实例锁，否则新实例可能在旧线程
+        // 仍在运行时启动。
+        for (int i = 0; i < executors.size(); i++) {
+            ExecutorService executor = executors.get(i);
+            try {
+                if (!executor.awaitTermination(WORKER_TERMINATION_TIMEOUT_MS, TimeUnit.MILLISECONDS)) {
+                    Ln.w("Daemon: " + names.get(i) + " executor did not terminate within "
+                            + WORKER_TERMINATION_TIMEOUT_MS + "ms; forcing shutdownNow");
+                    executor.shutdownNow();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                executor.shutdownNow();
+            }
+        }
+
+        TcpServerSocketListener.closeServerSocket();
+        InstanceMutex.release();
+    }
+
+    public void requestExit() {
+        running.set(false);
+        synchronized (runLock) {
+            runLock.notifyAll();
+        }
+    }
+
+    void removeSession(int sessionId) {
+        sessions.remove(sessionId);
+        Ln.i(DaemonLog.tag(sessionId) + ": session removed");
+    }
+}
