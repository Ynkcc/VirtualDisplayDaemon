+package com.genymobile.scrcpy.daemon.video;
+
+import java.nio.ByteBuffer;
+
+final class Frame {
+
+    private static final class Data {
+        private final byte[] bytes;
+        private int refCount;
+
+        Data(byte[] bytes) {
+            this.bytes = bytes;
+            this.refCount = 1;
+        }
+
+        synchronized void retain() {
+            refCount++;
+        }
+
+        synchronized void release() {
+            if (--refCount == 0) {
+                ByteArrayPool.recycle(bytes);
+            }
+        }
+    }
+
+    static final int KIND_HEADER = 0;
+    static final int KIND_META = 1;
+    static final int KIND_PACKET = 2;
+
+    final int kind;
+
+    private final Data data;
+    final int length;
+    final long pts;
+    final boolean config;
+    final boolean keyFrame;
+
+    final int width;
+    final int height;
+    final boolean isClientResize;
+
+    private Frame(int kind, Data data, int length, long pts, boolean config, boolean keyFrame,
+                  int width, int height, boolean isClientResize) {
+        this.kind = kind;
+        this.data = data;
+        this.length = length;
+        this.pts = pts;
+        this.config = config;
+        this.keyFrame = keyFrame;
+        this.width = width;
+        this.height = height;
+        this.isClientResize = isClientResize;
+    }
+
+    static Frame header() {
+        return new Frame(KIND_HEADER, null, 0, 0L, false, false, 0, 0, false);
+    }
+
+    static Frame meta(int width, int height, boolean isClientResize) {
+        return new Frame(KIND_META, null, 0, 0L, false, false, width, height, isClientResize);
+    }
+
+    static Frame packet(ByteBuffer buffer, long pts, boolean config, boolean keyFrame) {
+        int len = buffer.remaining();
+        byte[] bytes = ByteArrayPool.get(len);
+        buffer.duplicate().get(bytes, 0, len);
+        return new Frame(KIND_PACKET, new Data(bytes), len, pts, config, keyFrame, 0, 0, false);
+    }
+
+    void retain() {
+        if (data != null) {
+            data.retain();
+        }
+    }
+
+    void release() {
+        if (data != null) {
+            data.release();
+        }
+    }
+
+    byte[] getData() {
+        return data != null ? data.bytes : null;
+    }
+
+    boolean isDroppable() {
+        return kind == KIND_PACKET && !keyFrame && !config;
+    }
+
+    @Override
+    public String toString() {
+        switch (kind) {
+            case KIND_HEADER: return "Frame[HEADER]";
+            case KIND_META: return "Frame[META " + width + "x" + height + " resize=" + isClientResize + "]";
+            case KIND_PACKET: return "Frame[PACKET len=" + length + " pts=" + pts
+                    + " config=" + config + " key=" + keyFrame + "]";
+            default: return "Frame[?]";
+        }
+    }
+}
