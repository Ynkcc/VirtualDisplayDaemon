+package com.genymobile.scrcpy.daemon.display;
+
+import com.genymobile.scrcpy.util.Ln;
+import com.genymobile.scrcpy.video.ExternalDisplayProvider;
+import android.hardware.display.VirtualDisplay;
+import android.view.Surface;
+
+import com.genymobile.scrcpy.model.Size;
+
+public final class DisplaySurfaceBroker implements ExternalDisplayProvider {
+
+    private final VirtualDisplayRegistry registry;
+
+    public DisplaySurfaceBroker(VirtualDisplayRegistry registry) {
+        this.registry = registry;
+    }
+
+    @Override
+    public VirtualDisplay get(int displayId) {
+        return registry.getVirtualDisplay(displayId);
+    }
+
+    @Override
+    public void restore(int displayId) {
+        VirtualDisplaySession session = registry.getSession(displayId);
+        if (session == null) {
+            // 兜底 surface 未恢复：该 display 的 next resize 会以为外部 surface 仍在，
+            // 画面可能保持黑屏而无任何线索。
+            Ln.w("Daemon: cannot restore fallback surface, display id=" + displayId
+                    + " not found (resize may keep a stale surface)");
+            return;
+        }
+        session.restoreFallbackSurface();
+    }
+
+    @Override
+    public boolean markExternalSurface(int displayId, Surface surface) {
+        return registry.markExternalSurface(displayId, surface);
+    }
+
+    @Override
+    public Size getBoundedSize(int displayId) {
+        return registry.getBoundedSize(displayId);
+    }
+
+    @Override
+    public void setBoundedSize(int displayId, Size size) {
+        registry.setBoundedSize(displayId, size);
+    }
+}
