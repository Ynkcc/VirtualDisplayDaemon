+package com.genymobile.scrcpy.daemon.core;
+
+import com.genymobile.scrcpy.Options;
+import com.genymobile.scrcpy.control.Controller;
+import com.genymobile.scrcpy.daemon.display.VirtualDisplayRegistry;
+import com.genymobile.scrcpy.daemon.video.FrameBroadcasterRegistry;
+import com.genymobile.scrcpy.daemon.video.VideoSubscriber;
+import com.genymobile.scrcpy.util.Ln;
+
+import java.io.FileDescriptor;
+import java.io.IOException;
+import java.net.Socket;
+import java.util.function.BooleanSupplier;
+
+/**
+ * 每个 (sessionId, displayId) 一份的视频控制器，是共享
+ * {@link FrameBroadcasterRegistry} 的薄客户端。
+ *
+ * <p>视频流生命周期直接绑定 (ROLE_VIDEO, displayId) socket：绑定 socket 即
+ * {@code registry.acquire} 保住 VirtualDisplay，并向共享 broadcaster 订阅；
+ * socket 关闭 / 会话清理时按相反顺序释放两者。
+ *
+ * <p>一个会话可持有多个实例（每个 displayId 一个），彼此不共享状态。
+ */
+public final class SessionVideoController {
+
+    private final int sessionId;
+    private final int displayId;
+    private final String tag;
+    private final TcpVideoBinding videoBinding;
+    private final Options options;
+    private final String[] baseArgs;
+    private final FrameBroadcasterRegistry broadcasterRegistry;
+    private final VirtualDisplayRegistry virtualDisplayRegistry;
+    private final BooleanSupplier isSessionExited;
+
+    private Controller controller;
+    private VideoSubscriber currentSubscriber;
+
+    private boolean videoStarted = false;
+    private boolean vdAcquired = false;
+
+    public interface TcpVideoBinding {
+        FileDescriptor getVideoFd();
+
+        boolean hasVideo();
+
+        void bindVideoSocket(Socket socket) throws IOException;
+    }
+
+    public SessionVideoController(int sessionId, int displayId, TcpVideoBinding videoBinding,
+                                  Options options, String[] baseArgs,
+                                  FrameBroadcasterRegistry broadcasterRegistry,
+                                  VirtualDisplayRegistry virtualDisplayRegistry,
+                                  BooleanSupplier isSessionExited) {
+        this.sessionId = sessionId;
+        this.displayId = displayId;
+        this.tag = DaemonLog.tag(sessionId, displayId);
+        this.videoBinding = videoBinding;
+        this.options = options;
+        this.baseArgs = baseArgs;
+        this.broadcasterRegistry = broadcasterRegistry;
+        this.virtualDisplayRegistry = virtualDisplayRegistry;
+        this.isSessionExited = isSessionExited;
+    }
+
+    public void setController(Controller controller) {
+        this.controller = controller;
+    }
+
+    /**
+     * 由接受线程在 (ROLE_VIDEO, displayId) socket 到达时调用：先绑定 socket，
+     * 再立即启动视频流（VD acquire + 订阅）。
+     */
+    public void bindVideoSocket(Socket socket) {
+        synchronized (this) {
+            try {
+                // 旧流仍标记为活动时（客户端已关 socket 但死亡回调未触发，或显式重绑）
+                // 先停掉，保证新 socket 拿到全新订阅者与全新 VD 引用。
+                if (videoStarted) {
+                    Ln.i(tag + ": re-bind video socket for displayId=" + displayId
+                            + ", stopping previous stream first");
+                    stopVideoInternal();
+                }
+                videoBinding.bindVideoSocket(socket);
+                Ln.i(tag + ": video socket bound for displayId=" + displayId
+                        + ", auto-starting stream");
+                if (!startVideoStreamInternal()) {
+                    Ln.w(tag + ": auto-start failed for displayId=" + displayId);
+                }
+            } catch (IOException e) {
+                Ln.e(tag + ": failed to bind video socket displayId=" + displayId, e);
+            }
+        }
+    }
+
+    private synchronized boolean startVideoStreamInternal() {
+        if (isSessionExited.getAsBoolean()) {
+            return false;
+        }
+        if (videoStarted) {
+            return true;
+        }
+        if (!videoBinding.hasVideo() || videoBinding.getVideoFd() == null) {
+            Ln.w(tag + ": no video socket available (displayId=" + displayId + ")");
+            return false;
+        }
+
+        // 视频流必须为其订阅期间保住 display：displayId!=0 且注册表已知该显示器时取引用。
+        if (virtualDisplayRegistry != null && displayId != 0
+                && !vdAcquired && virtualDisplayRegistry.hasDisplay(displayId)) {
+            virtualDisplayRegistry.acquire(displayId, sessionId);
+            vdAcquired = true;
+        }
+
+        Ln.i(tag + ": launching video stream for displayId=" + displayId);
+        try {
+            VideoSubscriber subscriber = broadcasterRegistry.acquireSubscriber(
+                    displayId, sessionId, videoBinding.getVideoFd(), options, baseArgs, controller);
+            // 一次性死亡回调：客户端关闭视频 socket 时立即释放 VD 引用并复位状态，
+            // 使后续重绑能重新拉起流。捕获订阅者引用以抵御重绑竞态。
+            subscriber.setOnDeath(() -> onSubscriberDied(subscriber));
+            currentSubscriber = subscriber;
+            videoStarted = true;
+            Ln.i(tag + ": video stream started for displayId=" + displayId);
+            return true;
+        } catch (Exception e) {
+            Ln.e(tag + ": failed to start video stream displayId=" + displayId, e);
+            stopVideoInternal();
+            return false;
+        }
+    }
+
+    /**
+     * 订阅者写线程发现客户端视频 socket 死亡时调用（仅一次）：释放 VD 引用 + 订阅者，
+     * 使显示器在无其他持有者时可被销毁，并允许重绑重新拉起流。
+     *
+     * <p>以 {@code currentSubscriber == deadSub} 为界，避免已替换的旧订阅者的陈旧
+     * 回调拆掉更新的流（重绑在同一把锁内替换订阅者）。
+     */
+    private synchronized void onSubscriberDied(VideoSubscriber deadSub) {
+        if (currentSubscriber == deadSub) {
+            Ln.i(tag + ": video subscriber died (displayId=" + displayId
+                    + "), releasing VD ref + resetting stream state");
+            stopVideoInternal();
+        } else {
+            Ln.i(tag + ": stale subscriber died (displayId=" + displayId
+                    + ") — already replaced by re-bind, skipping teardown");
+        }
+    }
+
+    /** 统一拆除入口：绑定回滚、会话清理、重绑前均可安全调用。 */
+    public synchronized void stopVideoInternal() {
+        if (currentSubscriber != null) {
+            broadcasterRegistry.releaseSubscriber(displayId, sessionId, currentSubscriber);
+            currentSubscriber = null;
+        }
+        videoStarted = false;
+
+        if (vdAcquired && virtualDisplayRegistry != null) {
+            virtualDisplayRegistry.release(displayId, sessionId);
+            vdAcquired = false;
+        }
+        Ln.i(tag + ": video stream stopped (displayId=" + displayId + ")");
+    }
+}
