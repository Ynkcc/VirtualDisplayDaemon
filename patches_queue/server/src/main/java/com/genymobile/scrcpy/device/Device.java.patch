+            if (wedgeFailureCount == 0 || now - wedgeFirstFailureAt > WEDGE_FAILURE_WINDOW_MS) {
+                wedgeFirstFailureAt = now;
+                wedgeFailureCount = 1;
+                Ln.w("Input event rejected by system_server for displayId=" + displayId);
+                return;
+            }
+            wedgeFailureCount++;
+            if (wedgeFailureCount >= WEDGE_FAILURE_THRESHOLD) {
+                Ln.e("Virtual display input appears wedged: " + wedgeFailureCount
+                        + " injection failures on displayId=" + displayId
+                        + " within " + WEDGE_FAILURE_WINDOW_MS + "ms; restarting daemon to recover"
+                        + " (system_server rejects touch injection; see 'Input event injection ... failed' in system log)");
+                System.exit(1);
+            }
+        }
     }
 
