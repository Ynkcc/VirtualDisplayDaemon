+    private static void trackInjectionResult(boolean injected, int displayId) {
+        if (displayId <= 0) {
+            // 楔死仅影响 daemon 创建的虚拟屏
+            return;
+        }
+        synchronized (wedgeLock) {
+            long now = SystemClock.elapsedRealtime();
+            if (injected) {
+                wedgeFailureCount = 0;
+                return;
