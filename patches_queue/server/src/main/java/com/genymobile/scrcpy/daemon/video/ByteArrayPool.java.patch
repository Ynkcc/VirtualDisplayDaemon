+package com.genymobile.scrcpy.daemon.video;
+
+import java.util.Deque;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.LinkedBlockingDeque;
+
+final class ByteArrayPool {
+    private static final int MAX_POOL_SIZE_PER_BUCKET = 8;
+    private static final Map<Integer, LinkedBlockingDeque<byte[]>> pool = new ConcurrentHashMap<>();
+
+    private ByteArrayPool() {}
+
+    static byte[] get(int size) {
+        int bucketSize = roundUpToPowerOfTwo(size);
+        Deque<byte[]> bucket = pool.get(bucketSize);
+        byte[] array = bucket != null ? bucket.pollFirst() : null;
+        return array != null ? array : new byte[bucketSize];
+    }
+
+    static void recycle(byte[] array) {
+        if (array == null) {
+            return;
+        }
+        int bucketSize = array.length;
+        if ((bucketSize & (bucketSize - 1)) != 0) {
+            return;
+        }
+        // offerLast 在桶满时静默丢弃：回收是优化路径，不允许阻塞编码线程。
+        pool.computeIfAbsent(bucketSize, k -> new LinkedBlockingDeque<>(MAX_POOL_SIZE_PER_BUCKET)).offerLast(array);
+    }
+
+    private static int roundUpToPowerOfTwo(int n) {
+        if (n <= 0) return 1;
+        n--;
+        n |= n >> 1;
+        n |= n >> 2;
+        n |= n >> 4;
+        n |= n >> 8;
+        n |= n >> 16;
+        return n + 1;
+    }
+}
